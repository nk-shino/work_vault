# ---- 面取り数テーブルの生成 ----
# nksv560サーバの unitInfo DBにある面取数情報を取得して、
# %mentori{(品目コード)}に展開する。
# 引数：なし
# 戻り値：正常時:"0"、$ret1:処理件数、%mentori{(品目コード)}= (面取数)
#		エラー時:"err"、$ret1:エラー詳細
sub get_mentori(){
	$ret1 = 0 ;
	my ($db, $st, $sql, $ary_ref) ;
	# nksv560サーバ($db2_source)のunitInfoテーブルから品目、基板取数を取得
	$sql = "SELECT `typeID`,`chldID` FROM ".$db2_unitInfo." WHERE `typeID` LIKE 'U%' ;" ;
	eval{
		$db = DBI->connect($db2_source, $db_user, $db_passwd, {PrintError => 0, AutoCommit => 1}) or die(DBI::errstr) ;
		$st = $db->prepare($sql) or die(DBI::errstr) ;
		$st->execute() or die(DBI::errstr) ;
		$ary_ref = $st->fetchall_arrayref ;
		$st->finish ;
		$db->disconnect ;
	};
	#DBでエラーがある場合の処理
	if ($@){
		if(defined($db)){$db->disconnect() ;}
		$ret1 .= "sql : ".$sql."\n ==> ".$@ ;
		return "err" ;
	}
	foreach (@$ary_ref){
		@$_[1] =~ /(\d{1,3})/ ;			# 数字部分のみを抽出
		$mentori{@$_[0]} = $1 ;
		$ret1 = $ret1 + 1 ;
	}
	return $ret1 ;
}

# ---- 未着手指図BOMを読む ----
# bossBOM DB (未着手SMT指図BOM)から指図BOMを取得して、
# %boss_BOM{(品目コード)}に保存と、登録日時を取得する。
# 引数：なし
# 戻り値：正常時:"0"、$ret1:処理件数、%boss_BOM{(品目コード)}= [(指図),(部品コード),(基数)],[]…
#		エラー時:"err"、$ret1:エラー詳細
sub read_BOM(){
	$ret1 = 0 ;
	my ($db, $st, $sql, $ary_ref) ;
	$regDate = "" ;
	$sql = "SELECT typeID,orderNumber,partNo,qty,regDate FROM ".$db_bossBOM." " ;
	$sql .= "WHERE 1 ORDER BY `partNo` ASC ;" ;
	# EGprowebサーバ($db_source)のbossBOMテーブルから品目、指図、部品コード、基数(1台)、登録日を取得
	eval{
		$db = DBI->connect($db_source, $db_user, $db_passwd, {PrintError => 0, AutoCommit => 1}) or die(DBI::errstr) ;
		$st = $db->prepare($sql) or die(DBI::errstr) ;
		$st->execute() or die(DBI::errstr) ;
		$ary_ref = $st->fetchall_arrayref ;
		$st->finish ;
		$db->disconnect ;
	};
	#DBでエラーがある場合の処理
	if ($@){
		if(defined($db)){$db->disconnect() ;}
		$ret1 .= "sql : ".$sql."\n ==> ".$@ ;
		return "err" ;
	}
	foreach (@$ary_ref){
		if ( $regDate eq "" ){ $regDate = @$_[4] ; }	# 登録日は IFID139.csv→bossBOM 登録日
		push ( @{ $boss_BOM{@$_[0]} } , ([ @$_[1],@$_[2],@$_[3] ]) ) ;
		$ret1 = $ret1 + 1 ;
	}
	return $ret1 ;
}

# ---- EGProのDBを読んでローカルのDBを更新 ----
# EGProの［T_部品配列表］の所要数を集計してローカルの egproBOM DB より新しければ
# 基数を一台あたりに変換して egproBOM DB を更新、社外生産分を含んだ egproBOM DB 
# 全体を %egpro_BOM 配列に展開する。
# 引数：なし($boss_BOM{(品目コード)}のキー値
# 戻り値：正常時: "0"、$egpro_BOM{(品目コード)} = [(部品コード),(個数),(登録日時)]…
#		エラー時: "err"、$ret1: エラー詳細
sub read_egDB(){
	$ret1 = 0 ;
	my ($db, $st, $sql, $ary_ref, $typeID) ;
	my %bom ;
	my @egpro ;
	my ($lastUpd, $partNo, $qty) ; 
	# egProDBを読む
	eval{
		$db = DBI->connect($db_ODBCserver, $db_ODBCuser, $db_ODBCpasswd, {PrintError => 0, AutoCommit => 1}) or die(DBI::errstr) ;
		$db->{LongTruncOk}=1 ;
		$db->{LongReadLen}=200000 ;
		# EGprosrvの［T_部品配列表］から品目コード,管理コード(指図),登録日時で重複なしの古い順に取得
		$sql = "SELECT DISTINCT 製品,管理コード,登録日時 FROM ".$db_ODBCview." " ;
		$sql .= "ORDER BY 登録日時 ASC ;" ;
		$st = $db->prepare($sql) or die(DBI::errstr) ;
		$st->execute() or die(DBI::errstr) ;
		$ary_ref = $st->fetchall_arrayref ;
		my %typeList ;
		# 品目コードをキーとして、登録日時昇順で上書き → 最後の上書きが最新
		foreach (@$ary_ref){
			$typeList{@$_[0]} = [@$_[1],@$_[2]] ;		# $typeList{(品目コード)} = [管理コード,登録日時]
		}
		# EGprosrvの［T_部品配列表］から品目毎に最新の管理コード(指図)で集計
		foreach $typeID (keys %boss_BOM){				# BOSS発令の品目コードで当該指図を順次取得
#		foreach $typeID (keys %typeList){				# EGprosrvの全品目コードで当該指図を順次取得
			if (!$typeList{$typeID}){next ;	}			# 空は次
			$typeList{$typeID}[0] =~ s/^(\d+)\-\d+/$1/ ;	# 管理コードの指図部分を抽出
			# 最新管理コード(指図)の全品番(部品)をEGprosrv［T_部品配列表］から取得
			$sql = "SELECT 品番1,員数,登録日時 FROM ".$db_ODBCview." " ;
			$sql .= "WHERE 管理コード LIKE '".$typeList{$typeID}[0]."%' ;" ;
			$st = $db->prepare($sql) or die(DBI::errstr) ;
			$st->execute() or die(DBI::errstr) ;
			$ary_ref = $st->fetchall_arrayref ;			# @$ary_ref：品番1[0],員数[1],登録日時[2]
			$lastUpd = $typeList{$typeID}[1] ;			# 登録日時を取得
			$lastUpd =~ s/^(\d{4}-\d{2}-\d{2}\s\d{2}:\d{2}:\d{2}).+/$1/ ;
			# 全$bom{(部品コード)}を合計計算
			%bom = () ;
			foreach my $eachNPM(@$ary_ref){
				if (!$bom{@$eachNPM[0]}){
					$bom{@$eachNPM[0]} = @$eachNPM[1] ;							# 初出
				}else{
					$bom{@$eachNPM[0]} = $bom{@$eachNPM[0]} + @$eachNPM[1] ;	# 既出なら累計を計算
				}
			}
			# EGPro新Ver(登録日が2021-02-21以降)は面取り数で1台毎に換算(EGPro旧Ver.は1台毎基数のまま)
			@egpro = () ;
			if ( !$mentori{$typeID} ){ $mentori{$typeID} = 1 ; }	# 面取り数未登録時のエラーを回避
			if ( unixTime($lastUpd) <= unixTime('2021-02-21 00:00:00') ){ $mentori{$typeID} = 1 ; }
			foreach (keys %bom){								# 部品コード毎に1台毎基数にして配列化
				# @egpro = [(部品コード),(個数),(登録日時)][…]…
				push ( @egpro , ([$_ ,int ($bom{$_}/$mentori{$typeID}), $lastUpd ]) ) ;
			}
			push (@{ $egpro_BOM{$typeID} } , @egpro) ;			# egpro_BOMに配列として追加
			$ret1 = $ret1 + 1 ;
		}
#print "(356)UE-4213/".Dumper($egpro_BOM{'UE-4213'})."/".$lastUpd."<br>\n" ; 
		$db->disconnect ;
		# EGprowebから egproBOM DB の登録日を取得し、［T_部品配列表］の最新更新日が新しければ更新(同時にplantを"社内"にする)
		$db = DBI->connect($db_source, $db_user, $db_passwd, {PrintError => 0, AutoCommit => 0}) or die(DBI::errstr) ;
		foreach $typeID (keys %egpro_BOM){
#if ($typeID eq "UE-4213") {print "(361)" ;}
			@egpro = @{$egpro_BOM{$typeID}} ;
			# ［T_部品配列表］更新日時を取得
			$lastUpd = $egpro[0]->[2] ;
			$lastUpd =~ s/^(\d{4}-\d{2}-\d{2}\s\d{2}:\d{2}:\d{2}).+/$1/ ;
			# egproBOM DBの最新更新日時を取得(日付が複数ある場合あり)
			$sql = "SELECT `regDate` FROM `".$db_egproBOM."` WHERE `typeID` LIKE ? ORDER BY `regDate` DESC ;" ;
			$st = $db->prepare($sql) or die(DBI::errstr) ;
			$st->execute($typeID) or die(DBI::errstr) ;
			$ary_ref = $st->fetchrow_arrayref ;
	#if ($typeID eq "UE-4213") {print "(371)".Dumper($ary_ref) ;}
			$st->finish() ;
			if (defined @$ary_ref[0]){
				@$ary_ref[0] =~ s/^(\d{4}-\d{2}-\d{2}\s\d{2}:\d{2}:\d{2})/$1/ ;
				# ［T_部品配列表］が古ければ次
# 半成り半製品統合でDBに書きにいかないため"="をとる。(2021/04/16)
				if ( &unixTime($lastUpd) < &unixTime(@$ary_ref[0]) ){next ; }
			}
			# ［T_部品配列表］が新しいまたはegproBOM DBにない品目は、egproBOM DBの当該品目を消去して追加
			$sql = "DELETE FROM ".$db_egproBOM." WHERE `typeID` LIKE ? ;" ;
			$st = $db->prepare($sql) or die(DBI::errstr) ;
			$st->execute( $typeID ) or die(DBI::errstr) ;
			$st = $db->commit ;
			$sql = "INSERT INTO ".$db_egproBOM." (typeID,partNo_egpro,qty,plant,regDate) VALUES " ;
			foreach (@egpro){
				# typeID,partNo_egpro,qty(int),plant("0"),regDate
				$sql .= "('".$typeID."','".@$_[0]."',".@$_[1].",'0','".@$_[2]."')," ;
				$ret1 = $ret1 + 1 ;
			}
			$sql =~ s/,$// ;
			$st = $db->prepare($sql) or die(DBI::errstr) ;
			$st->execute() or die(DBI::errstr) ;
			$st = $db->commit ;
		}
		# egproBOM DB から全品目の構成品目を %egpro_BOM に取得
		$sql = "SELECT typeID,partNo_egpro,qty,plant,regDate FROM `".$db_egproBOM."` " ;
		$sql .= "WHERE 1 ORDER BY `typeID` ;" ;
#print "(395)".$sql."<br>\n" ;
		$st = $db->prepare($sql) or die(DBI::errstr) ;
		$st->execute() or die(DBI::errstr) ;
		$ary_ref = $st->fetchall_arrayref ;
		$st->finish() ;
		$db->disconnect ;
	};
	if ($@){
		if (defined($db)){$db->disconnect() ;}
		$ret1 = "sql : ".$sql."\n ==> ".$@ ;
		return "err" ;
	}
#print "(407)".Dumper($ary_ref)."<br>\n" ; 
	%egpro_BOM = () ;
	foreach (@$ary_ref){				# $egpro_BOM{(品目)}で配列を生成
		push (@{ $egpro_BOM{@$_[0]} } , ([ @$_[1], @$_[2], @$_[4]]) );
	}
	foreach (keys %egpro_BOM){			# $egpro_BOM{(品目)}の中を部品コード順に並べ替え
		@{$egpro_BOM{$_}} = sort ( {@$a[0] cmp @$b[0]} @{$egpro_BOM{$_}} ) ;		# 部品コードを昇順にソート(boss_BOMも同順序)
	}
	return $ret1 ;
}

# ---- liveOrderDBからのデータ取得 ----
# SMT未着手指図をDBから指図順に取得する。
# 引数：なし
# 戻り値：正常時は取得内容のリファレンス
#		[(品目)[0],(指図)[1],(発令台数)[2],
#		 (指図登録日)[3],(製造開始日)[4],(完成予定日)[5],
# 		 (指図タイプ)[6],(担当ライン)[7]]
#		エラー時は"err"、詳細は$ret1
sub get_liveOrder(){
	$ret1 = "" ;
	my ($db, $st, $sql, $ary_ref) ;
	my $colList = $db_liveOrder_sub.".typeID,".$db_liveOrder_sub.".orderNumber,".$db_liveOrder_sub.".orderQty," ;
	$colList .= $db_liveOrder_sub.".reg_date,".$db_liveOrder_sub.".start_date,".$db_liveOrder_sub.".finish_date," ;
	$colList .= $db_liveOrder_sub.".sashizu_type,".$db_liveOrder_sub.".LINE " ;
	$sql = "SELECT ".$colList."FROM ".$db_liveOrder_sub." " ;
	$sql .= "WHERE 1 " ;
	$sql .= "ORDER BY ".$db_liveOrder_sub.".orderNumber ASC ;" ;
	eval{
		$db = DBI->connect($db_source, $db_user, $db_passwd, {PrintError => 0, AutoCommit => 1}) or die($DBI::errstr) ;
		$st = $db->prepare($sql) or die(DBI::errstr) ;
		$st->execute() or die(DBI::errstr) ;
		$ary_ref = $st->fetchall_arrayref ;
		$st->finish() ;
		$db->disconnect ;
	};
	#DBでエラーがある場合の処理
	if ($@){
		$st = $db->rollback ;
		if(defined($db)){$db->disconnect() ;}
		$ret1 .= "sql : ".$sql."\n ==> ".$@ ;
		return "err" ;
	}
	return $ary_ref ;		# ref渡し
}

# ---- 未着手指図の差分出力 ----
# liveOrder_subの指図に従い、boss_BOMとegpro_BOMの差分を配列に出力する。
# 引数：liveOrder_subの内容(指図順)
#		[(品目)[0],(指図)[1],(発令台数)[2],(指図登録日)[3],(製造開始日)[4],(完成予定日)[5],
#		(指図タイプ)[6],(担当ライン)[7]]
#		%boss_BOM{(品目コード)}、%egpro_BOM{(品目コード)}
# 戻り値：正常時: "0"
# 		エラー時: "err"、$ret1: エラー詳細
sub calc_sabun(){
	my @liveOrder = @{$_[0]} ;		# de-refして2次元配列
	$ret1 = 0 ;
	# $boss_BOM{(品目コード)} = [(指図)[0],(部品コード)[1],(基数)[2]],…
	#  → $sashizu_BOM{(指図)} = [(部品コード)[0],(個数)[1]],…
	my %sashizu_BOM ;
	foreach my $typeID (keys %boss_BOM ){
		foreach ( @{ $boss_BOM{$typeID} } ){
#print "(469)".@$_[0]."/".@$_[1]."/".@$_[2]."<br>\n";
			push (@{ $sashizu_BOM{@$_[0]} } , ([ @$_[1], @$_[2] ]) );
		}
	}
	# 指図毎に処理
	while ($liveOrder[$ret1]){
		my $typeID = $liveOrder[$ret1][0] ;		# 品目コードの取得
		my $sas_key = $liveOrder[$ret1][1] ;	# 指図の取得
		if (!$sashizu_BOM{$sas_key}){			# 発令部品無しは差分N.A.
			$ret1 = $ret1 + 1 ;
			next ; 
		}
		# 当該指図で部品Cを昇順に並べ替え($egpro_BOMはソート済み)
		@{ $sashizu_BOM{$sas_key} } = sort ({@$a[0] cmp @$b[0]} @{ $sashizu_BOM{$sas_key} }) ;
		# 部品コード順にポインタを移動して比較、結果を $bomDiff に保存
		my ($boss_Indx, $egpro_Indx) = (0, 0) ;
		my @partNo = @{ $sashizu_BOM{$sas_key} } ;
		my $diff = "0" ;
		my $regDate ;
		if (defined $egpro_BOM{$typeID}[$egpro_Indx][2]){		# EGpro登録日あれば取得
			$regDate = $egpro_BOM{$typeID}[$egpro_Indx][2] ;
		}
		my $itemDiff = "" ;						# 1品目毎の差分結果(sqlのVALUES句)
		while (){
			my $boss = $partNo[$boss_Indx][0] ;
			my $egpr = $egpro_BOM{$typeID}[$egpro_Indx][0] ;
			my $comp ;
			my $order = "211517136" ;
			# boss_BOM,egpro_BOMの部品毎にEOFまでチェックし、@liveOrder,@bomDiffを生成
			# @bomDiff = [(品目コード),(指図),(部品コード),(boss基数),(egpro基数),(egpro登録日時)]
			if (!$boss && !$egpr){
				# boss/egpro両方がundef(EOF)になったら比較終了
				last ;
			}elsif (!$boss){
				# bossの部品Cがない ==> boss部品が基数NULL、egpro部品が実数、登録日あり
#if ($sas_key eq $order){print "(504)".$boss."！＞".$egpr."<br>\n" ;} 
				$comp = "('".$typeID."','".$sas_key."','".$egpr."'," ;
				$comp .= "NULL,'".$egpro_BOM{$typeID}[$egpro_Indx][1]."'," ;
				$comp .= "'".$egpro_BOM{$typeID}[$egpro_Indx][2]."')\t" ;
				$diff = "egp" ;					# 差分ありフラグ(egp)
				$egpro_Indx = $egpro_Indx + 1 ;	# 次のegpro部品
			}elsif ($boss =~ /U.S/){
				# boss部品でURS/UTS/UESが存在 ==> 差分に"URS"を入れて即判定を抜ける
				$diff = "URS" ;					# 差分ありフラグ(URS)
				last ;
			}elsif (!$egpr){
				# egproの部品Cがない ==> boss部品が実数、egpro部品が基数NULL、登録日NULL
#if ($sas_key eq $order){print "(516)".$boss."＞！".$egpr."<br>\n" ;} 
				$comp = "('".$typeID."','".$sas_key."','".$boss."'," ;
				$comp .= "'".$partNo[$boss_Indx][1]."',NULL," ;
				$comp .= "NULL)\t" ;
				$diff = "bos" ;					# 差分ありフラグ(bos)
				$boss_Indx = $boss_Indx + 1 ;	# 次のboss部品
			}elsif ($boss gt $egpr) {
				# bossの部品C＞egproの部品C ==> boss部品が基数NULL、egpro部品が実数、登録日あり
#if ($sas_key eq $order){print "(524)".$boss."＞＞".$egpr."<br>\n" ;} 
				$comp = "('".$typeID."','".$sas_key."','".$egpr."'," ;
				$comp .= "NULL,'".$egpro_BOM{$typeID}[$egpro_Indx][1]."'," ;
				$comp .= "'".$egpro_BOM{$typeID}[$egpro_Indx][2]."')\t" ;
				$diff = "egp" ;					# 差分ありフラグ(egp)
				$egpro_Indx = $egpro_Indx + 1 ;	# 次のegpro部品
			}elsif ($boss lt $egpr) {
				# bossの部品C＜egproの部品C ==> boss部品が実数、egpro部品が基数NULL、登録日NULL
#if ($sas_key eq $order){print "(532)".$boss."＜＜".$egpr."<br>\n" ;} 
				$comp = "('".$typeID."','".$sas_key."','".$boss."'," ;
				$comp .= "'".$partNo[$boss_Indx][1]."',NULL," ;
				$comp .= "NULL)\t" ;
				$diff = "bos" ;					# 差分ありフラグ(bos)
				$boss_Indx = $boss_Indx + 1 ;	# 次のboss部品
			}elsif ($boss eq $egpr) {
				# bossの部品C＝egproの部品C ==> 両方が実数 
#if ($sas_key eq $order){print "(540)".$boss."＝＝".$egpr."<br>\n" ;} 
				$comp = "('".$typeID."','".$sas_key."','".$boss."'," ;
				$comp .= "'".$partNo[$boss_Indx][1]."','".$egpro_BOM{$typeID}[$egpro_Indx][1]."'," ;
				$comp .= "'".$egpro_BOM{$typeID}[$egpro_Indx][2]."')\t" ;
				if ($partNo[$boss_Indx][1] != $egpro_BOM{$typeID}[$egpro_Indx][1]){		# 実数に差分あり？
					$diff = "egp" ;				# 差分ありフラグ(egp)
				}
				$boss_Indx = $boss_Indx + 1 ;
				$egpro_Indx = $egpro_Indx + 1 ;
			}
#if ($sas_key eq $order){print "(550)".$comp." ＝＝＞ ".$diff."<br>\n" ;}
#if ($sas_key eq $order){print "(551)".$order.":".$regDate."<br>\n" ;}
			$itemDiff .= $comp ;
		}
		# bossの部品Cで半成品あり(フラグ："URS") ==> 何も追加しない、当該のliveOrder行を削除。
		if ($diff eq "URS"){
			splice ( @liveOrder, $ret1, 1 ) ;	# spliceするのでポインタは変えない
		}else{
#print "(558)".$itemDiff." ＝＝＞ ".$diff."<br>\n" ;
			$bomDiff .= $itemDiff ;			# 結果を追加して抜ける。
			# EGPro差分：有/無/更新済/未登録の判定("無"で"登録日＝今日"なら変更済:"bos")
#print "(561)".$sas_key.":".$regDate ;
			if (defined $regDate){
				$regDate =~ s/^(\d{4}-\d{2}-\d{2}).+/$1/ ;
				&dateTime(time) =~ /^(.+)\s/ ;
				if (($diff eq "0") && ($regDate eq $1)){ $diff = "upd" ;}
#print "(566)".$diff."<br>\n" ;
			}else{
				$diff = "-999" ;			# EGproDB未登録
#print "(569)".$diff."<br>\n" ;
			}
			# 配列の当該要素の末尾要素として追加
			push ( @{$liveOrder[$ret1]} , $diff ) ;
			$ret1 = $ret1 + 1 ;
		}
	}
	return \@liveOrder ;		# ref化して渡し
}

# ---- 差分詳細DBの更新 ----
# 差分チェックされたデータから生成されたsqlコマンドで
# bomDiff DBを更新する。
# 引数：差分チェック結果のリファレンス
#		[(品目)[0],(指図)[1],(発令台数)[2],(指図登録日)[3],(製造開始日)[4],
# 			(完成予定日)[5],(指図タイプ)[6],(担当ライン)[7],(差分フラグ)[8]]
# 戻り値：正常時は "0"
#		エラー時は"err"、詳細は$ret1
sub upd_bomDiff(){
	my ($db, $st, $sql) ;
	$ret1 = 0 ;
	eval{
		$db = DBI->connect($db_source, $db_user, $db_passwd, {PrintError => 0, AutoCommit => 0}) or die($DBI::errstr) ;
		# 仕掛中指図BOMDB(172.254.253.60.orderNumber.bomDiff)に差分詳細を書込み
		# 旧データの削除
		$sql = "TRUNCATE TABLE ".$db_bomDiff." ;" ;
		$st = $db->prepare($sql) or die(DBI::errstr) ;
		$st->execute() or die(DBI::errstr) ;
		$st = $db->commit ;
		# 新データの書込み
		$sql = "INSERT INTO `".$db_bomDiff."` " ;
		$sql .= "(`typeID`,`orderNumber`,`subType`,`unitQty`,`eg_unitQty`,`eg_regDate`) VALUES " ;
		foreach (split ("\t", $bomDiff)){
			$sql .= $_."," ;
			$ret1 = $ret1 + 1 ;
			if ($ret1 % 1000 == 0){
				$sql =~ s/,$// ;
				$sql .= " ON DUPLICATE KEY UPDATE " ;
				$sql .= "`unitQty`=VALUES(unitQty),`eg_unitQty`=VALUES(eg_unitQty),`eg_regDate`=VALUES(eg_regDate) ;" ;
				$st = $db->prepare($sql) or die(DBI::errstr) ;
				$st->execute() or die(DBI::errstr) ;
				$st = $db->commit ;
				$sql = "INSERT INTO `".$db_bomDiff."` " ;
				$sql .= "(`typeID`,`orderNumber`,`subType`,`unitQty`,`eg_unitQty`,`eg_regDate`) VALUES " ;			
			}
		}
		$sql =~ s/,$/ / ;
		$sql .= "ON DUPLICATE KEY UPDATE " ;
		$sql .= "`unitQty`=VALUES(unitQty),`eg_unitQty`=VALUES(eg_unitQty),`eg_regDate`=VALUES(eg_regDate) ;" ;
		$st = $db->prepare($sql) or die(DBI::errstr) ;
		$st->execute() or die(DBI::errstr) ;
		$st = $db->commit ;
		$db->disconnect ;
	};
	#DBでエラーがある場合の処理
	if ($@){
		$st = $db->rollback ;
		if(defined($db)){$db->disconnect() ;}
		$ret1 = "sql : ".$sql."\n ==> ".$@ ;
		# print "<br>(628)".$ret1."<br>\n" ;
		return "err" ;
	}
	return $ret1 ;
}


# ---- html文の生成 ----
# 差分チェックされたデータからhtmlを生成する。
# 引数：差分チェック結果のリファレンス
#		[(品目)[0],(指図)[1],(発令台数)[2],(指図登録日)[3],(製造開始日)[4],
# 			(完成予定日)[5],(指図タイプ)[6],(担当ライン)[7],(差分フラグ)[8]]
# 戻り値：正常時はhtmlテキスト
#		エラー時は"err"、詳細は$ret1
sub make_html(){
	my @eachRec = @{$_[0]} ;		# de-refして2次元配列
	my $cont = "" ;
	my $row = 0 ;
	foreach (@eachRec){
# print "(647)".Dumper($_)."<br>\n" ;		
		my @col = @$_ ;
		my $sts ;
		$col[2] = $col[2] + 0 ;				# 発令台数を整数化
		$col[3] =~ s/(\d{4})(\d{2})(\d{2})/$1-$2-$3/ ;	# yyyy-mm-dd
		$col[4] =~ s/(\d{4})(\d{2})(\d{2})/$1-$2-$3/ ;
		$col[5] =~ s/(\d{4})(\d{2})(\d{2})/$1-$2-$3/ ;
		if ($col[8] eq "egp" || $col[8] eq "bos" ){	# 不一致：赤
			$sts = "<img src=\"./cgiData/red.png\">" ;
		}elsif ($col[8] eq "upd"){					# 登録今日：青
			$sts = "<img src=\"./cgiData/blu.png\">" ;
		}elsif ($col[8] eq "0"){					# 一致：緑
			$sts = "<img src=\"./cgiData/grn.png\">" ;
		}elsif ($col[8] eq "-999"){					# EGpro未登録：白
			$sts = "<img src=\"./cgiData/wht.png\">" ;
		}else{
			$sts = "N.A." ;
		}
		$sts = "<span onclick=\"openWindow(\'".$indv_scrn."?sashizu=".$col[1]."&sts=".$col[8]."\'); return false;\">".$sts."</span>" ;
		if ($row % 2){								# 行毎の色変え
			$cont .= "\t\t<tr class=\"even\">\n" ;
		}else{
			$cont .= "\t\t<tr class=\"odd\">\n" ;
		}
		$cont .= "\t\t\t<td onclick=\"openWindow(\'".$indv_scrn."?sashizu=".$col[1]."&sts=".$col[8]."\'); return false;\">" ;
		$cont .= "<b><font color=\"4040ff\"><a class=\"hov\">".$col[1]."</a></font></b></td>\n" ;
		$cont .= "\t\t\t<td>".$col[7]."</td><td>".$col[0]."</td><td>".$col[2]."</td>" ;
		$cont .= "<td>".$col[3]."</td><td>".$col[4]."</td><td>".$col[5]."</td>\n" ;
		$cont .= "\t\t\t<td>".$col[6]."</td><td>".$sts."</td>\n" ;
		$cont .= "\t\t</tr>\n" ;
		$row = $row + 1 ;
	}
	return $cont ;						# htmlを戻す
}

# ---- Logの出力 ----
# 引数で渡されるメッセージのlogファイル出力。
# バッファリングを解除、書込み禁止して排他処理して更新。
# 引数：メッセージテキスト
# 戻り値：エラーなしはNULL、ありはメッセージを返す。
sub recLog(){
	if (open (FH, ">>", $logFile)){
		print FH @_ ;
		close FH ;
	}else{
		$ret1 = "Log File Error:".$! ;
		close FH;
		return "err" ;
	}
	close FH ;
	return 0 ;
}

# ---- 入力引数の評価 ----
# %in{''}で渡された入力引数を評価。
# 引数：なし(グローバル変数で%in
# 戻り値：なし(グローバル変数で%in)
sub eval_arg(){
	# モードの設定
	if (defined $in{'chgplant'}){$in{'mode'} = 'chgplant' ;}		# 「生産場所変更」
	if (defined $in{'updBOM'}){$in{'mode'} = 'updBOM' ;}			# 「bossBOM更新」
}

# ---- エラー表示処理 ----
# エラーメッセージを表示
# 引数:エラーテキスト
# 戻り値:なし
sub error(){
		print "Content-type:text/html\n\n" ;
		print "<html>\n<body><meta charset=\"utf-8\" />\n" ;
		print "\t<br>".$_[0]."<br>\n" ;
		print "</body>\n</html>\n" ;
}

