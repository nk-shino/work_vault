			$db_ODBCserver =~ s/(.+:)(.+)$/$1$val/ ;
		}
	}
	$ret1 = "=> system reads 'bom_diff.ini' " ;
	&recLog($ret1) ;
}
close IN ;
# cgiから%in{}にパラメータを取得
$CGI::POST_MAX = 2048 * 1024 ;		# postは最大2Mbytesまで
