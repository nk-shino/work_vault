$t0 = gethrtime() ;
&upd_bomDiff($bomDiff) ;
$ret1 = "=> put_bomDiff:".int((gethrtime() - $t0)/1000000)."msec " ;
&recLog ($ret1." => ".&dateTime(time)." *** normal end ***") ;
goto exit_prog ;

#********************************************
#                 Sub処理
