          <mxGeometry height="40" width="1090" x="40" y="440" as="geometry" />
        </mxCell>
        <mxCell id="L5_U0a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#243447;fontSize=11;fontStyle=1;" value="×0.7 の設計意図" vertex="1">
          <mxGeometry height="52" width="200" x="60" y="486" as="geometry" />
        </mxCell>
        <mxCell id="L5_U0b" parent="1" style="text;html=1;fontSize=11;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" value="÷0.7が「余裕を持たせる」狙いか、別の意図(稼働率補正等)か。佐藤さん・実装技術課への確認が必要。" vertex="1">
          <mxGeometry height="52" width="840" x="272" y="486" as="geometry" />
        </mxCell>
        <mxCell id="L5_U1a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#243447;fontSize=11;fontStyle=1;" value="BOMシートへのCT転記経路" vertex="1">
          <mxGeometry height="52" width="200" x="60" y="548" as="geometry" />
        </mxCell>
        <mxCell id="L5_U1b" parent="1" style="text;html=1;fontSize=11;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" value="差分確認マクロBOM作成シートのE列CTが、MySQL実績平均とどう連結しているか(手作業/リンク)未確認。" vertex="1">
