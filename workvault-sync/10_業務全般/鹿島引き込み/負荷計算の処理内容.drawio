        </mxCell>
        <mxCell id="L5_C0b" parent="1" style="text;html=1;fontSize=11;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" value="実装技術課の管理: DGS最速値(設備最大性能)。&lt;br&gt;生産1課の実績: MySQL最新10指図の平均。&lt;br&gt;負荷計算に使うのは実績平均の方。両者の差が&lt;br&gt;BSM-1700マスター検証の要点。" vertex="1">
          <mxGeometry height="86" width="850" x="252" y="134" as="geometry" />
        </mxCell>
        <mxCell id="L5_C1a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontColor=#243447;fontSize=11;fontStyle=1;" value="28秒下限" vertex="1">
          <mxGeometry height="86" width="180" x="60" y="230" as="geometry" />
        </mxCell>
        <mxCell id="L5_C1b" parent="1" style="text;html=1;fontSize=11;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" value="DGS実績が短すぎる場合の共通クリップ値。&lt;br&gt;BOSS計画パワークエリ・BOM作成シートで同じ28秒。" vertex="1">
          <mxGeometry height="86" width="850" x="252" y="230" as="geometry" />
        </mxCell>
        <mxCell id="L5_C2a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontColor=#243447;fontSize=11;fontStyle=1;" value="0.7 の方向" vertex="1">
          <mxGeometry height="86" width="180" x="60" y="326" as="geometry" />
        </mxCell>
        <mxCell id="L5_C2b" parent="1" style="text;html=1;fontSize=11;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" value="コードは全て ÷0.7(工数を約1.43倍に膨らませる)。&lt;br&gt;会議メモは「DGS最大値×安全係数」と記録。×方向は&lt;br&gt;実装と一致しない。意図は関係者への確認が必要。" vertex="1">
          <mxGeometry height="86" width="850" x="252" y="326" as="geometry" />
        </mxCell>
        <mxCell id="L5_R2" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FEFBF0;strokeColor=#B85450;strokeWidth=2;dashed=0;verticalAlign=top;" value="" vertex="1">
