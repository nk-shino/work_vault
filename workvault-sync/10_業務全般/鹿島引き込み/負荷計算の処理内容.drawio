        </mxCell>
        <mxCell id="L5_C0a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontColor=#243447;fontSize=11;fontStyle=1;" value="サイクルタイム 2系統" vertex="1">
