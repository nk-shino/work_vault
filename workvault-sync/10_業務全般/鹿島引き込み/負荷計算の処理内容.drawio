        </mxCell>
        <mxCell id="L4_F2" value="②sp = CT ÷ 面数(表裏)&lt;br&gt;   BOM作成シートN列 =($E$15/$F$15)&amp;&quot;sp&quot; (単位 sp=秒/個)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontColor=#243447;fontSize=11;fontFamily=Courier New;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="56" y="240" width="560" height="60" as="geometry" />
        </mxCell>
        <mxCell id="L4_F3" value="③製造効率 = UseBomInst_ProductionFactor&lt;br&gt;   実装0.7 / 目視0.6 / 外観検査0.5 / 二課1.0&lt;br&gt;   0.7なら実時間の約1.43倍を計上" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontColor=#243447;fontSize=11;fontFamily=Courier New;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1">
