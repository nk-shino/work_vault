        <mxCell id="L4_F1" value="作業時間 = ①数量 × ②sp ÷ ③製造効率 + ④段取" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontColor=#243447;fontSize=14;fontFamily=Courier New;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1">
