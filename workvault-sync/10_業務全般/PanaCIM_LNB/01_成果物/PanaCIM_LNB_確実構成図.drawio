  <diagram id="p4" name="事象別_異常時再起動">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1120" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title4" value="事象別切り分け図：異常時のサーバー再起動（第10章 10-4）" style="text;html=1;fontFamily=Meiryo;fontSize=24;align=center;verticalAlign=middle;fontColor=#922B21;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="24" width="1600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle4" value="発動条件：生産時「生産情報が取得できません。」エラーで情報の取得ができない場合（操作手順書 0494-912039(06)）。全ラインの生産と作業を停止させる" style="text;html=1;fontFamily=Meiryo;fontSize=13;align=center;verticalAlign=middle;fontColor=#6B7280;" vertex="1" parent="1">
          <mxGeometry x="60" y="66" width="1600" height="26" as="geometry" />
        </mxCell>
        <mxCell id="trigger" value="発動条件
「生産情報が取得できません。」
エラー発生" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fillColor=#FADBD8;strokeColor=#C0392B;fontColor=#922B21;fontSize=13;fontStyle=1;arcSize=10;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="approval" value="停止判断者の承認
（実施には承認が要る）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fillColor=#FCF3CF;strokeColor=#8A6D0B;fontColor=#7D6608;fontSize=13;fontStyle=1;arcSize=10;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1">
          <mxGeometry x="400" y="130" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="stop_phase" value="第1段 停止（手順1〜6）" style="swimlane;whiteSpace=wrap;html=1;fontFamily=Meiryo;startSize=34;fillColor=#FDECEC;strokeColor=#C0392B;fontColor=#922B21;fontSize=15;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;rounded=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="80" y="280" width="720" height="300" as="geometry" />
        </mxCell>
        <mxCell id="st1" value="手順1
全ラインの生産と作業を停止させる
（ここから先は生産が止まる）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fillColor=#FADBD8;strokeColor=#C0392B;fontColor=#922B21;fontSize=13;fontStyle=1;arcSize=10;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="stop_phase">
          <mxGeometry x="20" y="50" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="st2" value="手順2〜3
CIM-C PC：シャットダウン
（ペンギン写真を確認して画面を閉じる）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fillColor=#FADBD8;strokeColor=#C0392B;fontColor=#922B21;fontSize=13;arcSize=10;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="stop_phase">
          <mxGeometry x="360" y="50" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="st4" value="手順4
ESXi ホスト：メンテナンスモードへ変更" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fillColor=#FADBD8;strokeColor=#C0392B;fontColor=#922B21;fontSize=13;arcSize=10;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="stop_phase">
          <mxGeometry x="20" y="170" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="st6" value="手順6
CIM-A PC：シャットダウン" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fillColor=#FADBD8;strokeColor=#C0392B;fontColor=#922B21;fontSize=13;arcSize=10;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="stop_phase">
          <mxGeometry x="360" y="170" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="start_phase" value="第2段 起動（手順7〜14）" style="swimlane;whiteSpace=wrap;html=1;fontFamily=Meiryo;startSize=34;fillColor=#EAF7EE;strokeColor=#1E8449;fontColor=#1E5631;fontSize=15;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;rounded=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="860" y="280" width="780" height="300" as="geometry" />
        </mxCell>
        <mxCell id="st7" value="手順7〜8
CIM-C/A PC の電源ON（3分待つ）
CIM-A PC にログオン" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fillColor=#D5F5E3;strokeColor=#1E8449;fontColor=#186A3B;fontSize=13;arcSize=10;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="start_phase">
          <mxGeometry x="20" y="50" width="350" height="90" as="geometry" />
        </mxCell>
        <mxCell id="st11" value="手順11
ESXi：メンテナンスモードの終了
（飛ばすと仮想マシンを起動できない）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fillColor=#D5F5E3;strokeColor=#1E8449;fontColor=#186A3B;fontSize=13;fontStyle=1;arcSize=10;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="start_phase">
          <mxGeometry x="400" y="50" width="350" height="90" as="geometry" />
        </mxCell>
        <mxCell id="st12" value="手順12〜13
CIMC-SV：パワーオン
ユーザー・パスワード入力（Continue）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fillColor=#D5F5E3;strokeColor=#1E8449;fontColor=#186A3B;fontSize=13;arcSize=10;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="start_phase">
          <mxGeometry x="20" y="170" width="350" height="90" as="geometry" />
        </mxCell>
        <mxCell id="st14" value="手順14
「Route Editer」を選択して起動完了" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fillColor=#D5F5E3;strokeColor=#1E8449;fontColor=#186A3B;fontSize=13;fontStyle=1;arcSize=10;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="start_phase">
          <mxGeometry x="400" y="170" width="350" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;strokeColor=#C0392B;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0" edge="1" parent="1" source="trigger" target="approval">
