<mxCell id="le5_lbl" value="バックアップ（手作業）" style="edgeLabel;html=1;fontFamily=Meiryo;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#82B366;labelBackgroundColor=#FFFFFF;fontStyle=1;" vertex="1" connectable="0" parent="le5"><mxGeometry x="0" y="0" relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry></mxCell>        <mxCell id="le6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;strokeColor=#8A6D0B;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0" edge="1" parent="1" source="lnbmap" target="l1">
