        <mxCell id="w1PNnFOrz5dVDE4hTmzd-1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F3864;" value="固定テーブル棚卸 ─ データの出どころ・結合キー・各処理が存在する理由" vertex="1">
          <mxGeometry height="44" width="1500" x="50" y="20" as="geometry" />
        </mxCell>
        <mxCell id="w1PNnFOrz5dVDE4hTmzd-2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#333333;" value="棚卸の目的は「実装機に載ったままの部品（固定テーブル）の現物」と「EG-Proの在庫データ」を一致させること。" vertex="1">
          <mxGeometry height="30" width="2400" x="50" y="72" as="geometry" />
        </mxCell>
        <mxCell id="w1PNnFOrz5dVDE4hTmzd-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;arcSize=8;container=0;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=14;spacingTop=6;" value="&lt;b&gt;設備（実装機）&lt;/b&gt;&lt;br&gt;どのZ軸・スロットに、どのリールが載っているか&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="82" width="420" x="50" y="130" as="geometry" />
        </mxCell>
        <mxCell id="w1PNnFOrz5dVDE4hTmzd-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;arcSize=8;container=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=14;spacingTop=6;" value="&lt;b&gt;Pana-CIM&lt;/b&gt;&lt;br&gt;設備側の生産管理システム&lt;br&gt;設備操作から約10分で反映" vertex="1">
          <mxGeometry height="82" width="420" x="50" y="280" as="geometry" />
        </mxCell>
        <mxCell id="w1PNnFOrz5dVDE4hTmzd-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;arcSize=8;container=0;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;spacingTop=6;" value="&lt;b&gt;セットアップレポートCSV&lt;/b&gt;（Pana-CIM出力）&lt;br&gt;主な列：ライン名/ゾーン名/設備名/レーン/ステージ番号/Z/PU番号/スロット番号/&lt;br&gt;サブスロット番号(L/R)/&lt;b&gt;材料バーコード&lt;/b&gt;/&lt;b&gt;部品番号&lt;/b&gt;/正規部品/ロット番号/ベンダー/&lt;br&gt;初期数量/部品取付時間/作業者/スプライシング/メインリール/&lt;b&gt;スプライシングリール&lt;/b&gt;&lt;br&gt;※見出しは3行目。材料BC=9列、部品番号=10列、スプライシングリール=21列" vertex="1">
          <mxGeometry height="117" width="620" x="50" y="430" as="geometry" />
        </mxCell>
        <mxCell id="w1PNnFOrz5dVDE4hTmzd-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;arcSize=8;container=0;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;spacingTop=6;" value="&lt;b&gt;EG-Pro在庫CSV&lt;/b&gt;（EGProWhereHouse.csv・1リール1行）&lt;br&gt;列：&lt;b&gt;シリアル番号&lt;/b&gt;/&lt;b&gt;品番&lt;/b&gt;/発注番号/入荷日時/受入数/&lt;b&gt;在庫数&lt;/b&gt;/ステータス名称/&lt;b&gt;ロケーション名称&lt;/b&gt;/棚/&lt;br&gt;棚分類コード/最終更新日時&lt;br&gt;ステータス実値：貯蔵/生産中/生産終了/出庫/受入&lt;br&gt;ロケーション実値：棚/設備(L2)/ハズシ(L2)/2ライン倉庫/0確認(L2)&lt;br&gt;※3・4・11列目はCSV単体にヘッダが無く、対応づけは推定を含む" vertex="1">
          <mxGeometry height="136" width="700" x="730" y="430" as="geometry" />
        </mxCell>
        <mxCell id="w1PNnFOrz5dVDE4hTmzd-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;arcSize=8;container=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;spacingTop=6;" value="&lt;b&gt;固定テーブル配列データ&lt;/b&gt;（★固定マスタ）&lt;br&gt;固定テーブル上の物理位置を決める元データ&lt;br&gt;取込時に「フィーダーセットアップ」行より上を削除&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="98" width="560" x="1490" y="430" as="geometry" />
        </mxCell>
        <mxCell id="w1PNnFOrz5dVDE4hTmzd-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;arcSize=8;container=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=14;spacingTop=6;" value="&lt;b&gt;セットアップレポート計算機TEC56.xlsm ─ 計算結果_整形シート&lt;/b&gt;（照合の中核/A〜T列）&lt;br&gt;8列 テーブル番号 = 配列!A2*2 + 配列!C2 - 2　　9列 Z = 配列!D2 &amp; IF(配列!E2=&quot;L&quot;,1,IF(配列!E2=&quot;R&quot;,2,0))&lt;br&gt;10列 部品番号　12列 シリアル番号　13列 EGPro在庫　15列 スプライシングシリアル　16列 スプライシング側EGPro在庫　19列 スプライシング判定(◯)&lt;br&gt;※20列目・A〜G列の正式定義は未確認" vertex="1">
          <mxGeometry height="102" width="2000" x="50" y="666" as="geometry" />
        </mxCell>
        <mxCell id="w1PNnFOrz5dVDE4hTmzd-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;arcSize=8;container=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;spacingTop=6;" value="&lt;b&gt;結合キー（なぜ結合できるのか）&lt;/b&gt;&lt;br&gt;セットアップレポートの「材料バーコード」＝ EG-Proの「シリアル番号」で&lt;b&gt;完全一致&lt;/b&gt;結合する。&lt;br&gt;例：9000070668 100101 / 581416B100019&lt;br&gt;&lt;br&gt;部品識別は3階層&lt;br&gt;① シリアル番号（材料バーコード）＝リール1本を一意識別&lt;br&gt;② 部品番号（品番）＝品目単位。複数リールをここで集約する&lt;br&gt;③ 正規部品/ロット番号＝列は存在するが提供データでは空欄&lt;br&gt;&lt;br&gt;・スプライシングリールも同じくシリアル番号で照合する（別リールとして扱う）&lt;br&gt;・材料バーコードとスプライシングリールを&lt;b&gt;文字列連結してはいけない&lt;/b&gt;&lt;br&gt;・同一値なら1回だけ集計する（二重計上を避ける）&lt;br&gt;・T付特採は別品番・別レコード。先頭Tを機械的に除去しない" vertex="1">
          <mxGeometry height="269" width="620" x="50" y="838" as="geometry" />
        </mxCell>
        <mxCell id="w1PNnFOrz5dVDE4hTmzd-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;arcSize=8;container=0;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;spacingTop=6;" value="&lt;b&gt;下流① 現場部品リスト（GenbaList）&lt;/b&gt;&lt;br&gt;抽出条件：10列(部品番号)が非空 かつ 12列(シリアル)が非空 かつ 8列(テーブル番号)≠14&lt;br&gt;出力列：テーブル番号/Z/部品番号/シリアル/スプライシング(● または ●後側)/EGPro在庫&lt;br&gt;&lt;br&gt;&lt;b&gt;なぜ存在するか&lt;/b&gt;：ここで作ったD列のシリアル一覧が、そのまま倉庫移動SQLのIN句になる。&lt;br&gt;このリストを作らずにSQL作成を押すと、対象が空か前回の古いリストで更新してしまう。手順書に&lt;br&gt;「必ず実行」と書かれているのはこのため。&lt;br&gt;※テーブル番号14を除外する理由は未確認" vertex="1">
          <mxGeometry height="174" width="700" x="730" y="838" as="geometry" />
        </mxCell>
        <mxCell id="w1PNnFOrz5dVDE4hTmzd-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;arcSize=8;container=0;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;spacingTop=6;" value="&lt;b&gt;下流② 倉庫移動SQL（idouSQL）&lt;/b&gt;&lt;br&gt;対象：[EGProKOHDEN-Warehouse].[dbo].T_在庫データ&lt;br&gt;キー：シリアル番号 IN（現場部品リストのD列）&lt;br&gt;更新：ロケーションコード ← マクロ実行!A55（棚卸し用倉庫 = 202）&lt;br&gt;　　　ステータスコード ← [EGProKOHDEN-MST].[dbo].M_ロケーション から引き当て&lt;br&gt;　　　ラインNo/設備No/Z軸No = NULL、更新日時 = GETDATE()&lt;br&gt;&lt;br&gt;&lt;b&gt;なぜ NULL にするのか&lt;/b&gt;：「このリールはもうどの設備のどの軸にも載っていない」という状態にし、&lt;br&gt;物理的に設備からリールを降ろした事実と辻褄を合わせるため。&lt;br&gt;&lt;br&gt;&lt;b&gt;なぜ存在するか&lt;/b&gt;：入庫処理にはハンディで1本ずつ読む方式もあるが、固定テーブルには数百本のリールが載るた&lt;br&gt;め、DBを直接更新して一括で片付ける代替手段として用意された。&lt;br&gt;&lt;b&gt;在庫数は変えない。したがってこの処理単体では差異は解消しない。&lt;/b&gt;" vertex="1">
          <mxGeometry height="269" width="700" x="1490" y="838" as="geometry" />
        </mxCell>
        <mxCell id="w1PNnFOrz5dVDE4hTmzd-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;arcSize=8;container=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;spacingTop=6;" value="&lt;b&gt;下流③ 不足部品リスト作成 ver7.xlsm（不足部品計算シート）&lt;/b&gt;&lt;br&gt;B 取付済在庫 … VBA（modEGProB列更新）がEG-Pro在庫から書き戻す値。&lt;b&gt;更新するのはこのB列だけ&lt;/b&gt;&lt;br&gt;E 取付済在庫 = IF(OR(ISNA(XLOOKUP(F2,A:A,B:B)),ISERR(...)),0,XLOOKUP(F2,A:A,B:B))　　F 部品 = 配列!F2&lt;br&gt;I リール情報 = XLOOKUP(TEXT(F2,&quot;@&quot;),リール情報!A:A,リール情報!B:B)　　J スプライシング必要残数 = XLOOKUP(TEXT(F2,&quot;@&quot;),PartList!B:B,PartList!H:H)&lt;br&gt;K 使用数 = XLOOKUP(F2,使用数計算!F:F,使用数計算!E:E)　　L 不足数 = E2-K2-J2　　M 不足リール数 = IF(L2&amp;lt;0,ABS(ROUNDUP(L2/I2,0)),&quot;&quot;)&lt;br&gt;Q 差引在庫数 = IF(M2=&quot;&quot;,E2-K2,E2-K2+M2*I2)　　R 差引在庫数2 = IF(K2=0,E2,IF(M2=&quot;&quot;,E2-K2,E2-K2+M2*I2))&lt;br&gt;&lt;br&gt;&lt;b&gt;なぜB列更新を新規に作ったのか&lt;/b&gt;：従来 main() は F列とR列を A列・B列へ値貼り付けしていた。つまり B → E → R → B の&lt;b&gt;自己参照ループ&lt;/b&gt;で、EG-Pro在庫が入る口がどこにも無かった。&lt;div&gt;さらにR列・L列にロス（ポッド落ち・実装失敗・スプライシングロス）を差し引く項が一つも無く、&lt;br&gt;理論値が過大なまま繰り越されて誤差が構造的に累積していた。&lt;br&gt;&lt;b&gt;実行順は EGPro連携（B列更新）→ Hojo → main。&lt;/b&gt; main を先に実行するとB列がR列で上書きされEG-Pro値が消える。実行前に A1:B560 を退避する。&lt;/div&gt;" vertex="1">
          <mxGeometry height="222" width="2000" x="50" y="1177" as="geometry" />
        </mxCell>
        <mxCell id="w1PNnFOrz5dVDE4hTmzd-13" edge="1" parent="1" source="w1PNnFOrz5dVDE4hTmzd-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#444444;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="w1PNnFOrz5dVDE4hTmzd-4">
