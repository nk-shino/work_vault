# このファイルには変数名と説明だけを書く。値（接続先・キー・パスワード）は書かない。
# 実際の値は、実行する前に環境変数で渡す（例：set LLM_BACKEND=litellm）。アプリは .env ファイルを読まない。
# 鍵をファイルに書くと、同期フォルダや USB に鍵が残るため。

# 取得元の切替。export = エクスポートファイル（.eml / CSV / JSONL）、knowledge_api = 既存のメールナレッジ化AI（未実装）
SOURCE_BACKEND=

# SOURCE_BACKEND=export のときに読むフォルダ
EXPORT_DIR=

# LLM の切替。mock = 固定応答（既定）、litellm = 社内 LiteLLM ゲートウェイ（実装済み・指定したときだけ使う）、local = ローカル埋め込み（骨格のみ）
LLM_BACKEND=

# litellm 用。OpenAI 互換。BASE_URL は https:// で始まり /v1 で終わる形。値はここに書かず、実行時に環境変数で渡す
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_CHAT_MODEL=
LITELLM_EMBED_MODEL=

# local 用。手元に置いた sentence-transformers モデルのフォルダ。ネットワークからは取得しない
LOCAL_EMBED_MODEL_DIR=

# SQLite ファイルの場所（省略時は data/glossary.db）
DATABASE_URL=
