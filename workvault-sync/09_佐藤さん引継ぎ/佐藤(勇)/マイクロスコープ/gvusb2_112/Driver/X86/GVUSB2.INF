;-------------------------------------------------------------------------------------------------------------------------------------------------------------------- INFOMATION
[Version]
Signature                             =                            "$CHICAGO$"	; FOR 95 & NT SYSTEMS
Class                                 =                                 MEDIA	; MEDIA CLASS
ClassGUID                             = {4D36E96C-E325-11CE-BFC1-08002BE10318}	; MEDIA CLASS GUID
Provider                              =                        %PROVIDER.NAME%	; PROVIDER NAME
DriverPackageDisplayName              =                         %PRODUCT.NAME%	; DRIVER PACKAGE DISPLAY NAME
DriverVer                             =                 06/07/2021, 1.1.0.193	; INF VERSION
CatalogFile                           =                            GVUSB2.CAT
[Manufacturer]
%MANUFACTURER.NAME%                   =                        ENTRY, NTamd64	; ASSIGN MODELS SECTION
[ControlFlags]
ExcludeFromSelect                     =                                     *	; 
[DestinationDirs]
DefaultDestDir                        =                                    11	; C:\WINDOWS\SYSTEM32
GVUSB2.CopyApplications               =                                 16409	; ..\DESKTOP
GVUSB2.CopyPropertyPages.X86          =                                    11	; C:\WINDOWS\SYSTEM32
GVUSB2.CopyPropertyPages.X64          =                          10, SYSWOW64	; C:\WINDOWS\SYSWOW64
GVUSB2.CopyDrivers                    =                  10, SYSTEM32\DRIVERS	; C:\WINDOWS\SYSTEM32\DRIVERS
[SourceDisksNames]
1                                     =                            %DISK.NAME%	;
[SourceDisksFiles]
GVUSB2.X86.SYS                        =                                     1	;
GVUSB2.X64.SYS                        =                                     1	;
GVUSB2.X86.AX                         =                                     1	;
GVUSB2.X64.AX                         =                                     1	;
GVUSB2.C86.AX                         =                                     1	;
GVUSB2.C64.AX                         =                                     1	;

;-------------------------------------------------------------------------------------------------------------------------------------------------------------------- MAIN ENTRY
[ENTRY]
%PRODUCT.GVUSB2.NAME% = GVUSB2.X86,  USB\VID_04BB&PID_0532 ; I-O DATA GV-USB2
%PRODUCT.GVUSB2.NAME% = GVUSB2.X86, USB2\VID_04BB&PID_0532

[ENTRY.NTamd64]
%PRODUCT.GVUSB2.NAME% = GVUSB2.X64,  USB\VID_04BB&PID_0532 ; I-O DATA GV-USB2
%PRODUCT.GVUSB2.NAME% = GVUSB2.X64, USB2\VID_04BB&PID_0532

[GVUSB2.X86]
Include       = KS.INF, KSCAPTUR.INF, WDMAUDIO.INF
Needs         = KS.REGISTRATION, KSCAPTUR.REGISTRATION, WDMAUDIO.REGISTRATION
AddReg        = GVUSB2.X86.AddReg, GVUSB2.AddReg
CopyFiles     = GVUSB2.CopyDrivers, GVUSB2.CopyPropertyPages.X86, GVUSB2.CopyApplications
RegisterDlls  = GVUSB2.RegisterDlls

[GVUSB2.X86.NT]
Include       = KS.INF, KSCAPTUR.INF, WDMAUDIO.INF
Needs         = KS.REGISTRATION, KSCAPTUR.REGISTRATION.NT, WDMAUDIO.REGISTRATION.NT
AddReg        = GVUSB2.X86.AddReg, GVUSB2.AddReg
CopyFiles     = GVUSB2.CopyDrivers, GVUSB2.CopyPropertyPages.X86, GVUSB2.CopyApplications
RegisterDlls  = GVUSB2.RegisterDlls

[GVUSB2.X64]
Include       = KS.INF, KSCAPTUR.INF, WDMAUDIO.INF
Needs         = KS.REGISTRATION, KSCAPTUR.REGISTRATION, WDMAUDIO.REGISTRATION
AddReg        = GVUSB2.X64.AddReg, GVUSB2.AddReg
CopyFiles     = GVUSB2.CopyDrivers, GVUSB2.CopyPropertyPages.X86, GVUSB2.CopyPropertyPages.X64, GVUSB2.CopyApplications
RegisterDlls  = GVUSB2.RegisterDlls

[GVUSB2.X64.NT]
Include       = KS.INF, KSCAPTUR.INF, WDMAUDIO.INF
Needs         = KS.REGISTRATION, KSCAPTUR.REGISTRATION.NT, WDMAUDIO.REGISTRATION.NT
AddReg        = GVUSB2.X64.AddReg, GVUSB2.AddReg
CopyFiles     = GVUSB2.CopyDrivers, GVUSB2.CopyPropertyPages.X86, GVUSB2.CopyPropertyPages.X64, GVUSB2.CopyApplications
RegisterDlls  = GVUSB2.RegisterDlls

