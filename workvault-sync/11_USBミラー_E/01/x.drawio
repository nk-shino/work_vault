        <!-- ========== STEP 1: セットアップレポート取得 ========== -->
        <mxCell id="s1" value="① セットアップレポート取得&#xa;EG-Proサーバー管理PC / NPM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="90" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s1_note" value="⚠️ セットアップレポートとEG-Pro CSVは&#xa;必ず同日・同時刻に取得すること&#xa;（3日ズレで160件が照合不能・実測）" style="shape=callout;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;perimeter=calloutPerimeter;size=10;position=0.5;direction=west;" vertex="1" parent="1">
          <mxGeometry x="610" y="85" width="260" height="60" as="geometry" />
        </mxCell>

        <!-- STEP 2: EG-Pro在庫CSV取得 -->
        <mxCell id="s2" value="② EG-Pro在庫CSV取得&#xa;第二生産部生産一課一係ノートブック経由" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="185" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s2_note" value="⚠️ 0確認を含まないCSVを使うこと&#xa;確認方法: H列に「0確認」が含まれないか&#xa;=COUNTIF(H:H,&quot;*0確認*&quot;) が 0 なら正しい形式" style="shape=callout;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;perimeter=calloutPerimeter;size=10;position=0.5;direction=west;" vertex="1" parent="1">
          <mxGeometry x="610" y="180" width="260" height="65" as="geometry" />
        </mxCell>

        <!-- STEP 3: 計算機へ貼付 -->
        <mxCell id="s3" value="③ セットアップレポート計算機.xlsm へ貼付&#xa;[セットアップレポート]シート / [EGPro]シート" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="280" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s3_note" value="⚠️ EGProシートの列順は固定（変更禁止）&#xa;A:シリアル / B:品番 / C:受入数&#xa;D:在庫数 / E:ステータス / F:ロケーション / G:棚&#xa;⚠️ 貼付開始セルの正式位置は【要確認】" style="shape=callout;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;perimeter=calloutPerimeter;size=10;position=0.5;direction=west;" vertex="1" parent="1">
          <mxGeometry x="610" y="272" width="260" height="72" as="geometry" />
        </mxCell>

        <!-- STEP 4: XLOOKUP突合 -->
        <mxCell id="s4" value="④ 品番コードをキーに XLOOKUP 突合&#xa;メインリール＋スプライシングリール 両方対象&#xa;→ ロケーション / 在庫数 / 受入数 を取得" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="375" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s4_note" value="⚠️ スプライシングは&#xa;メイン側が先に消費されて消え&#xa;繋いだ側だけEG-Proに残るケースが多い&#xa;（実測: 突合率 65%→80%向上）" style="shape=callout;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;perimeter=calloutPerimeter;size=10;position=0.5;direction=west;" vertex="1" parent="1">
          <mxGeometry x="610" y="370" width="260" height="72" as="geometry" />
        </mxCell>

        <!-- STEP 5: #N/A切り分け -->
        <mxCell id="s5" value="⑤ #N/A の切り分け（修正前に必須）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="480" width="280" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s5_note" value="⚠️ #N/A は「在庫ゼロ」ではない&#xa;キー不一致（空白・桁数・全半角）による&#xa;偽エラーの可能性あり&#xa;→ 修正対象に混ぜる前に必ず切り分ける" style="shape=callout;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;perimeter=calloutPerimeter;size=10;position=0.5;direction=west;" vertex="1" parent="1">
          <mxGeometry x="610" y="470" width="260" height="68" as="geometry" />
