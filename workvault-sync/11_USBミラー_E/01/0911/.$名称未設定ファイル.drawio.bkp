  <diagram name="1. 全体フロー" id="vmlzNCxf74kkmuDqnOeH">
    <mxGraphModel dx="973" dy="629" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="pool" parent="1" style="swimlane;html=1;horizontal=0;childLayout=stackLayout;resizeParent=0;resizeParentMax=0;startSize=34;horizontalStack=1;fontSize=14;fontStyle=1;fillColor=#F5F5F5;strokeColor=#666666;" value="固定テーブル　棚卸し方法　全体フロー" vertex="1">
          <mxGeometry height="2900" width="1330" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="lane1" parent="pool" style="swimlane;html=1;horizontal=1;startSize=34;fontSize=12;fontStyle=1;fillColor=none;strokeColor=#666666;" value="現場（実装機・台車・カウンタ・ハンディ）" vertex="1">
          <mxGeometry height="2900" width="340" x="30" as="geometry" />
        </mxCell>
        <mxCell id="n01" parent="lane1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;" value="開始：固定テーブルの最終生産終了" vertex="1">
          <mxGeometry height="50" width="296" x="22" y="70" as="geometry" />
        </mxCell>
        <mxCell id="n02" parent="lane1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=8;arcSize=8;" value="&lt;b&gt;1. 設備操作&lt;/b&gt;&lt;br&gt;① 配列が一致するJobを設備に読込&lt;br&gt;② 図1のボタン → ③ 図2の順に操作&lt;br&gt;※ 画面切替を確認しながらゆっくり／1人で実施" vertex="1">
          <mxGeometry height="85" width="296" x="22" y="150" as="geometry" />
        </mxCell>
        <mxCell id="n11" parent="lane1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=8;arcSize=8;" value="対象のZ軸の現物を確認し&lt;br&gt;正しくセットアップされていることを確認&lt;br&gt;→ 設備操作をやり直す" vertex="1">
          <mxGeometry height="75" width="296" x="22" y="1190" as="geometry" />
        </mxCell>
        <mxCell id="n13" parent="lane1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=8;arcSize=8;" value="現物を確認し、つなぎ目が無いことを確認&lt;br&gt;Pana-CIMハンディでスプライシング解除&lt;br&gt;① 設備上でフィーダー情報削除&lt;br&gt;② スプライシング解除 → ③ セットアップ" vertex="1">
          <mxGeometry height="95" width="296" x="22" y="1405" as="geometry" />
        </mxCell>
        <mxCell id="n15" parent="lane1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=8;arcSize=8;" value="&lt;b&gt;6. カウント前準備（ラベル貼り）&lt;/b&gt;&lt;br&gt;① テーブルを外しフィーダーから部品を取外し、台車の同じ場所へ整列&lt;br&gt;② 赤枠シリアルのバーコードを再発行（はんだ冷蔵庫付近のPC）&lt;br&gt;③ 元のシールは剥がさず、上から仮止めで貼付&lt;br&gt;④「新品ではない」リールに青丸シールを貼付" vertex="1">
          <mxGeometry height="110" width="296" x="22" y="1620" as="geometry" />
        </mxCell>
        <mxCell id="n16" parent="lane1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=8;arcSize=8;" value="&lt;b&gt;7. カウント実施（新リールカウンタ）&lt;/b&gt;&lt;br&gt;バーコードが1枚か2枚かを確認して分岐&lt;br&gt;※ 詳細はページ2「カウント・取付の判断フロー」参照" vertex="1">
          <mxGeometry height="80" width="296" x="22" y="1765" as="geometry" />
        </mxCell>
        <mxCell id="n19" parent="lane1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=8;arcSize=8;" value="EG-Proハンディターミナルで入庫画面を開き&lt;br&gt;印刷したバーコードを上 → 下の順に読取" vertex="1">
          <mxGeometry height="70" width="296" x="22" y="2090" as="geometry" />
        </mxCell>
        <mxCell id="n23" parent="lane1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=8;arcSize=8;" value="出力された部品の所在を現物確認" vertex="1">
          <mxGeometry height="55" width="296" x="22" y="2415" as="geometry" />
        </mxCell>
        <mxCell id="d04" parent="lane1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" value="現物が存在するか" vertex="1">
          <mxGeometry height="65" width="296" x="22" y="2500" as="geometry" />
        </mxCell>
        <mxCell id="n25" parent="lane1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=8;arcSize=8;" value="&lt;b&gt;10. 部品取り付け&lt;/b&gt;&lt;br&gt;バーコード枚数とスプライシングテープ長で分岐&lt;br&gt;※ 詳細はページ2「カウント・取付の判断フロー」参照" vertex="1">
          <mxGeometry height="80" width="296" x="22" y="2620" as="geometry" />
        </mxCell>
        <mxCell id="n26" parent="lane1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;" value="棚卸し完了" vertex="1">
          <mxGeometry height="50" width="296" x="22" y="2740" as="geometry" />
        </mxCell>
        <mxCell id="lane2" parent="pool" style="swimlane;html=1;horizontal=1;startSize=34;fontSize=12;fontStyle=1;fillColor=none;strokeColor=#666666;" value="Pana-CIM（設備系システム）" vertex="1">
          <mxGeometry height="2900" width="280" x="370" as="geometry" />
        </mxCell>
        <mxCell id="n03" parent="lane2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;arcSize=8;" value="設備情報がPana-CIMへ反映&lt;br&gt;（最後の設備操作から約10分待機）" vertex="1">
          <mxGeometry height="60" width="236" x="22" y="270" as="geometry" />
        </mxCell>
        <mxCell id="n04" parent="lane2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;arcSize=8;" value="&lt;b&gt;2. セットアップレポート出力&lt;/b&gt;&lt;br&gt;http://172.25.253.42/eplantview&lt;br&gt;モジュール「材料照合」／値「現在のセットアップレポート」&lt;br&gt;対象ライン・全設備を選択 → 適用 → ファイル保存" vertex="1">
          <mxGeometry height="95" width="236" x="22" y="360" as="geometry" />
        </mxCell>
        <mxCell id="note1" parent="lane2" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9C4;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" value="【凡例】&lt;br&gt;橙：現場作業&lt;br&gt;青：マクロ操作（事務PC）&lt;br&gt;紫：システム操作&lt;br&gt;赤：要注意（実データ直接更新）&lt;br&gt;黄：判断&lt;br&gt;赤破線：やり直しループ" vertex="1">
          <mxGeometry height="150" width="236" x="22" y="1650" as="geometry" />
        </mxCell>
        <mxCell id="lane3" parent="pool" style="swimlane;html=1;horizontal=1;startSize=34;fontSize=12;fontStyle=1;fillColor=none;strokeColor=#666666;" value="事務PC（セットアップレポート計算マクロ）" vertex="1">
          <mxGeometry height="2900" width="360" x="650" as="geometry" />
        </mxCell>
        <mxCell id="n05" parent="lane3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;arcSize=8;" value="マクロの「セットアップレポート」へ読み込ませる" vertex="1">
          <mxGeometry height="55" width="316" x="22" y="490" as="geometry" />
        </mxCell>
        <mxCell id="n08" parent="lane3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;arcSize=8;" value="マクロの「EG-Pro在庫情報入力」へ読み込ませる" vertex="1">
          <mxGeometry height="55" width="316" x="22" y="900" as="geometry" />
        </mxCell>
        <mxCell id="n09" parent="lane3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;arcSize=8;" value="&lt;b&gt;4. マクロ実行&lt;/b&gt;&lt;br&gt;① 配列情報を「配列情報入力」へ読込（★固定マスタ）&lt;br&gt;② セットアップレポートと配列の対応表を入力&lt;br&gt;③ 固定グループ名を入力" vertex="1">
          <mxGeometry height="85" width="316" x="22" y="990" as="geometry" />
        </mxCell>
        <mxCell id="n10" parent="lane3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;arcSize=8;" value="④「セットアップ情報取得失敗リスト印刷」を実行" vertex="1">
          <mxGeometry height="55" width="316" x="22" y="1105" as="geometry" />
        </mxCell>
        <mxCell id="d01" parent="lane3" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" value="対象部品があるか" vertex="1">
          <mxGeometry height="70" width="316" x="22" y="1190" as="geometry" />
        </mxCell>
        <mxCell id="n12" parent="lane3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;arcSize=8;" value="&lt;b&gt;5. スプライシング切替失敗部品処理&lt;/b&gt;&lt;br&gt;①「スプライシング切り替え失敗部品リスト印刷」を実行" vertex="1">
          <mxGeometry height="65" width="316" x="22" y="1305" as="geometry" />
        </mxCell>
        <mxCell id="d02" parent="lane3" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" value="対象部品があるか" vertex="1">
          <mxGeometry height="70" width="316" x="22" y="1405" as="geometry" />
        </mxCell>
        <mxCell id="n14" parent="lane3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;arcSize=8;" value="③「スプライシング部品リスト印刷」を実行" vertex="1">
          <mxGeometry height="55" width="316" x="22" y="1530" as="geometry" />
        </mxCell>
        <mxCell id="n18" parent="lane3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;arcSize=8;" value="「手動入庫処理バーコード作成」を実行" vertex="1">
          <mxGeometry height="55" width="316" x="22" y="2090" as="geometry" />
        </mxCell>
        <mxCell id="n20" parent="lane3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;arcSize=8;" value="「倉庫移動SQL作成」を使用&lt;br&gt;移動先を入力 →「現場部品リスト作成」（必ず実行）&lt;br&gt;→「倉庫移動SQL作成」でSQLを出力" vertex="1">
          <mxGeometry height="80" width="316" x="22" y="2185" as="geometry" />
        </mxCell>
        <mxCell id="n22" parent="lane3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;arcSize=8;" value="&lt;b&gt;9. EG-Pro所在不明リール処理&lt;/b&gt;&lt;br&gt;「所在不明リスト作成」を実行&lt;br&gt;※ 全てのフリー・固定部品の入庫処理完了後" vertex="1">
          <mxGeometry height="75" width="316" x="22" y="2410" as="geometry" />
        </mxCell>
        <mxCell id="lane4" parent="pool" style="swimlane;html=1;horizontal=1;startSize=34;fontSize=12;fontStyle=1;fillColor=none;strokeColor=#666666;" value="EG-Pro（在庫管理システム／サーバ）" vertex="1">
          <mxGeometry height="2900" width="320" x="1010" as="geometry" />
        </mxCell>
        <mxCell id="d00" parent="lane4" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" value="&lt;b&gt;3. EG-Pro在庫情報出力&lt;/b&gt;&lt;br&gt;方法1が使用できるか" vertex="1">
          <mxGeometry height="70" width="276" x="22" y="570" as="geometry" />
        </mxCell>
        <mxCell id="n06" parent="lane4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;arcSize=8;" value="&lt;b&gt;方法1（推奨・事務PC）&lt;/b&gt;&lt;br&gt;Get_EG_Tanaoroshi.cgi へアクセスし&lt;br&gt;在庫情報をダウンロード" vertex="1">
          <mxGeometry height="70" width="276" x="22" y="670" as="geometry" />
        </mxCell>
        <mxCell id="n07" parent="lane4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=left;spacingLeft=8;arcSize=8;" value="&lt;b&gt;方法2（方法1不可時のみ）&lt;/b&gt;&lt;br&gt;EG-Proサーバ（ラック最左PC）でSSMGを開き接続&lt;br&gt;新しいクエリ → SQL入力 → 実行 → 結果を名前を付けて保存&lt;br&gt;※ 実サーバのため慎重に作業" vertex="1">
          <mxGeometry height="95" width="276" x="22" y="770" as="geometry" />
        </mxCell>
        <mxCell id="n17" parent="lane4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;arcSize=8;" value="&lt;b&gt;8. 入庫処理（前処理）&lt;/b&gt;&lt;br&gt;生産計画アプリで「****-DMY」を選択 → 生産開始 → キャンセル&lt;br&gt;→ ステータス「生産中」の部品シリアルが「外し」に切替わる" vertex="1">
          <mxGeometry height="90" width="276" x="22" y="1870" as="geometry" />
        </mxCell>
        <mxCell id="d03" parent="lane4" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" value="入庫方式の選択" vertex="1">
          <mxGeometry height="70" width="276" x="22" y="1990" as="geometry" />
        </mxCell>
        <mxCell id="n21" parent="lane4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=left;spacingLeft=8;arcSize=8;" value="SSMGで出力SQLを実行し棚卸し用倉庫へ一括移動&lt;br&gt;※ EG-Proで在庫の変化／更新数の一致を必ず確認&lt;br&gt;※ トランザクションを張ると安全" vertex="1">
          <mxGeometry height="80" width="276" x="22" y="2295" as="geometry" />
        </mxCell>
        <mxCell id="n24" parent="lane4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;arcSize=8;" value="リール消費を実施（件数が多い場合はリール消費マクロ）&lt;br&gt;0確認：そのまま消費／ライン倉庫・外し：念のため探す&lt;br&gt;ラベル発行：部品管理が処理／借用：担当者へ連絡" vertex="1">
          <mxGeometry height="95" width="276" x="22" y="2500" as="geometry" />
        </mxCell>
