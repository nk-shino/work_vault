          <mxGeometry height="80" width="316" x="22" y="2225" as="geometry" />
        </mxCell>
        <mxCell id="e8VhPcJbI0qX20TrIUXA-25" parent="1" style="swimlane;html=1;horizontal=1;startSize=34;fontSize=12;fontStyle=1;container=0;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;EG-Pro(在庫管理システム/サーバ)&lt;/font&gt;" vertex="1">
