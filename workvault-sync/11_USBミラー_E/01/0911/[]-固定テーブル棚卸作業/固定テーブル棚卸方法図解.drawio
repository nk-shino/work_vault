          <mxGeometry height="2900" width="360" x="1354" y="1076" as="geometry" />
        </mxCell>
        <mxCell id="e8VhPcJbI0qX20TrIUXA-24" parent="e8VhPcJbI0qX20TrIUXA-23" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#dae8fc;strokeColor=#6c8ebf;fillStyle=solid;direction=west;gradientDirection=north;shadow=1;size=20;autosizeText=1;fontSize=6;align=left;" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b style=&quot;&quot;&gt;セットアップレポート計算マクロがすること&lt;/b&gt;&lt;br&gt;セットアップレポート(材料バーコード)とEG-Pro在庫(シリアル番号)を完全一致で結合し、固定テーブルの現物とEG-Proの差異を照合する。&lt;br&gt;取込は SETUPREPORT_Import がUTF-8からSJISへ変換し、EG_Import と HAIRETSU_Import で在庫と配列を読む。&lt;br&gt;結果は計算結果_整形シート(A〜T列)に集約し、現場部品リストと倉庫移動SQLを生成する。&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="320" x="22" y="212.999979654948" as="geometry" />
        </mxCell>
