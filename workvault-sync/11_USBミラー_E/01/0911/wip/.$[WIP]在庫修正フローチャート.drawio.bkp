        <mxCell id="fmYMfTSYUCx-Iuv30-7Y-8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" value="① セットアップレポートを取得する&#xa;EG-Proサーバー管理PC / NPM" vertex="1">
          <mxGeometry height="55" width="280" x="310" y="100" as="geometry" />
        </mxCell>
        <mxCell id="fmYMfTSYUCx-Iuv30-7Y-9" parent="1" style="shape=callout;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;perimeter=calloutPerimeter;size=10;position=0.5;direction=west;" value="セットアップレポートとEG-Pro CSVは&#xa;同じ日・できるだけ同じ時間帯に取得すること。&#xa;3日ずれるだけで160件が照合できなくなる（実測）。" vertex="1">
          <mxGeometry height="62" width="270" x="620" y="94" as="geometry" />
        </mxCell>
        <mxCell id="fmYMfTSYUCx-Iuv30-7Y-10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" value="② EG-Pro在庫CSVを取得する&#xa;第二生産部 生産一課一係 ノートブック経由" vertex="1">
          <mxGeometry height="55" width="280" x="310" y="195" as="geometry" />
        </mxCell>
        <mxCell id="fmYMfTSYUCx-Iuv30-7Y-11" parent="1" style="shape=callout;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;perimeter=calloutPerimeter;size=10;position=0.5;direction=west;" value="0確認が入っていないCSVを使うこと。&#xa;確認方法: H列に「0確認」が混じっていないか見る。&#xa;=COUNTIF(H:H,&quot;*0確認*&quot;) の結果が 0 なら正しい形式。" vertex="1">
          <mxGeometry height="66" width="270" x="620" y="188" as="geometry" />
        </mxCell>
        <mxCell id="fmYMfTSYUCx-Iuv30-7Y-12" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" value="③ セットアップレポート計算機.xlsm に貼り付ける&#xa;[セットアップレポート]シート / [EGPro]シート" vertex="1">
          <mxGeometry height="55" width="280" x="310" y="290" as="geometry" />
        </mxCell>
        <mxCell id="fmYMfTSYUCx-Iuv30-7Y-13" parent="1" style="shape=callout;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;perimeter=calloutPerimeter;size=10;position=0.5;direction=west;" value="EGProシートの列順は絶対に変えないこと。&#xa;A:シリアル / B:品番 / C:受入数 / D:在庫数&#xa;E:ステータス / F:ロケーション / G:棚&#xa;貼り付け開始セルの正式位置は要確認。" vertex="1">
          <mxGeometry height="72" width="270" x="620" y="281" as="geometry" />
        </mxCell>
        <mxCell id="fmYMfTSYUCx-Iuv30-7Y-14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" value="④ 品番コードをキーに突合する&#xa;メインリールとスプライシングリール、両方が対象&#xa;→ ロケーション / 在庫数 / 受入数 を引っ張る" vertex="1">
          <mxGeometry height="65" width="280" x="310" y="385" as="geometry" />
        </mxCell>
        <mxCell id="fmYMfTSYUCx-Iuv30-7Y-15" parent="1" style="shape=callout;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;perimeter=calloutPerimeter;size=10;position=0.5;direction=west;" value="スプライシングは、メイン側が先に使い切られて&#xa;EG-Proから消え、繋いだ側だけ残るケースが多い。&#xa;両方を見ることで突合率が大幅に上がる（実測）。" vertex="1">
          <mxGeometry height="66" width="270" x="620" y="378" as="geometry" />
        </mxCell>
        <mxCell id="fmYMfTSYUCx-Iuv30-7Y-16" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" value="⑤ #N/A を仕分けする（修正の前に必ずやること）" vertex="1">
          <mxGeometry height="45" width="280" x="310" y="490" as="geometry" />
        </mxCell>
        <mxCell id="fmYMfTSYUCx-Iuv30-7Y-17" parent="1" style="shape=callout;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;perimeter=calloutPerimeter;size=10;position=0.5;direction=west;" value="#N/A は在庫がゼロなのではなく、&#xa;シリアルの表記ゆれ（空白・桁数・全半角）で&#xa;うまく検索できていないだけのことも多い。&#xa;本当の差異かどうかを先に見極めること。" vertex="1">
