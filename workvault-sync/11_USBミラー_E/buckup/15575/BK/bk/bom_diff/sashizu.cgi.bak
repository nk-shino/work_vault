#!/usr/bin/perl -w

#**********************************************************
# このプログラムは、index.cgiで指図が選択されると起動され、
# 1.index.cgiが出力するEGprowebサーバのbomDiff DBから、
#   当該指図の差分情報を取得し、タイトル部分はorderNumber_sub DB
#   から取得して表示する。
# 2.差分ありで、nksv569サーバのECN DBに品目がある場合は、
#   ECNの内容を表示、無い場合は"ECN未発行"を表示する。
# 3.「変更」ボタンで、生産場所とBOSS基数をEGProwebサーバの
#   egproBPM DBに反映する。
# 4.除外登録のチェックボックス、「除外登録」のボタンで、
#   EGprowebサーバのexepPart DBへ対象部品の除外登録を行う。
#   ---(以下はbom_diff.js内で行う)---
# 5.「CSV出力」ボタンで、表示内容をcsv形式でファイルダウンロードする。
#									2021/01/11 J.Igarashi
# Ver. 1.00:初回リリース。
# Ver. 2.00:社外生産品への対応
#			(社内/社外の表示、自DBの生産場所stsを変更可)
#			ECNとの連携(ファイル有無を示す)
# Ver. 2.10:copy_BOSS.cgi,index.cgiを変更
# Ver. 2.11:除外コード登録で、試作ダミーコードに対応
#**********************************************************
my $ver = "2.11" ;
