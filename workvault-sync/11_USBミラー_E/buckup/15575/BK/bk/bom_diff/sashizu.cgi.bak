}

# **** 画面(再)表示の処理 ****
# 面取り数を取得
# if ( &get_mentori() eq "err" ){
	# &recLog( "failed to get mentori. :".$ret1."\n" ) ;
	# $ret1 = "面取り数の取得に失敗しました。<br>".$ret1 ;
