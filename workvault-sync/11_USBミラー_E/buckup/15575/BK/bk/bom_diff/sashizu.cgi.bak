		&error($ret1) ;
		goto exit_prog ;
	}
	# 親ウィンドウ/自画面を更新・閉じる
	my $html = <<"HTML";
Content-type:text/html

<html><body>
<script type="text/javascript">
	window.onload = function(){
		window.opener.location.reload();
		open('about:blank', '_self').close();	// 自ウィンドウを閉じる
	}
</script>
</body></html>
HTML
	print $html ;
