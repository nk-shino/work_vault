	if (&reg_exempt($in{'partNo'}) eq "err"){
		&recLog( "failed for adding item(s) to exempt DB.\n".$ret1."\n" ) ; 
		$ret1 = "除外リストへの登録に失敗しました。<br>".$ret1 ;
		&error($ret1) ;
		goto exit_prog ;
	}
	# bossBOM DBから削除
	if (&remv_bossBOM($in{'partNo'}) eq "err"){ 
