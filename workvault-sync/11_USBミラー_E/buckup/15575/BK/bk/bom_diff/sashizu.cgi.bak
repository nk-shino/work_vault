# ---- DBからのデータ取得 ----
# 差分チェック結果のbomDiff DBから指定された指図の結果を取得する。
# 引数：指図
# 戻り値：正常時は取得内容のリファレンス
#		エラー時は"err"、詳細は$ret1
sub getDB(){
	$ret1 = "" ;
	my @db_ary ;
	my ($db, $st, $sql, $ary_ref) ;
	eval{
		$db = DBI->connect($db_source, $db_user, $db_passwd, {PrintError => 0, AutoCommit => 1}) or die($DBI::errstr) ;
		# liveOrderテーブルから指図をキーに指図情報を取得(0,1,2,7,8,9)
		$sql = "SELECT typeID,orderNumber,orderQty,start_date,finish_date,LINE FROM ".$db_liveOrder_sub." " ;
		$sql .= "WHERE `orderNumber` LIKE '".$_[0]."' " ;
		$st = $db->prepare($sql) or die(DBI::errstr) ;
		$st->execute() or die(DBI::errstr) ;
		$ary_ref = $st->fetchrow_arrayref ;
		@db_ary = (@$ary_ref[0],@$ary_ref[1],@$ary_ref[2],3,4,5,6,@$ary_ref[3],@$ary_ref[4],@$ary_ref[5]) ;
#print "(276)".Dumper(@db_ary)."<br>" ;
		# egproBOMテーブルから品目をキーに生産場所情報を取得(10)
		$sql = "SELECT plant FROM ".$db_egproBOM." " ;
		$sql .= "WHERE `typeID` LIKE '".@$ary_ref[0]."' " ;
		$st = $db->prepare($sql) or die(DBI::errstr) ;
		$st->execute() or die(DBI::errstr) ;
		$ary_ref = $st->fetchrow_arrayref ;
		push ( @db_ary, @$ary_ref[0] ) ;				# 配列の最後に追加
		@db_ary = [@db_ary] ;							# 二次元配列化
#print "<br>(285)".Dumper(@db_ary)."<br>" ;
		# bomDiffテーブルから指図をキーに差分結果を取得(3,4,5,6)
		$sql = "SELECT subType,unitQty,eg_unitQty,eg_regDate FROM ".$db_bomDiff." " ;
		$sql .= "WHERE `orderNumber` LIKE '".$_[0]."' " ;
		$sql .= "ORDER BY subType ASC ;" ;
		$st = $db->prepare($sql) or die(DBI::errstr) ;
		$st->execute() or die(DBI::errstr) ;
		$ary_ref = $st->fetchall_arrayref ;
		$ret1 = 1 ;
		foreach (@$ary_ref){
			@db_ary[$ret1] = [0,1,2,@$_[0],@$_[1],@$_[2],@$_[3],7,8,9,10] ;
			$ret1 = $ret1 + 1 ;
#print "(297)".Dumper(@db_ary)."<br>" ;
		}
		@$ary_ref = @db_ary ;
		$st->finish() ;
		$db->disconnect ;
	};
	#DBでエラーがある場合の処理
	if ($@){
		if(defined($db)){$db->disconnect() ;}
		$ret1 .= "liveOrder_sub or bomDiff DB error : \nsql : ".$sql."\n ==> ".$@ ;
		return "err" ;
	}
#print "(309)".Dumper($ary_ref)."<br>" ;
	return $ary_ref ;
}

# ---- html文の生成 ----
# 取得された差分チェックされたデータをDBから取得する。
# 引数：DBから取得したデータ(配列)
# 戻り値：正常時はhtmlソーステキスト
#		1列目：[(品目コード)[0],(指図)[1],(発令数)[2],NULL[3],NULL[4],
#			NULL[5],NULL[6],製造開始日[7],完成予定日[8],担当[9],生産場所[10]]
#		2列目以降：[NULL[0],NULL[1],NULL[2],(部品コード)[3],(boss所要数)[4],
#		(egpro所要数)[5],egpro登録日時[6],NULL[7],NULL[8],NULL[9],NULL[10]],[],…
#		エラー時は"err"、詳細は$ret1
sub make_html(){
	$ret1 = 0 ;
	my $cont = "" ;
	my @row1 = shift @_ ;			# 先頭配列を切り取る
	$typeID = $row1[0]->[0] ;		# 品目コード
	$sashizu = $row1[0]->[1] ;		# 指図
	$qty = $row1[0]->[2] + 0 ;		# 発令台数
	$sttDate = $row1[0]->[7] ;		# 製造開始日
	$finDate = $row1[0]->[8] ;		# 完成予定日
	$line = $row1[0]->[9] ;			# 担当
	$plant = $row1[0]->[10] ;		# 生産場所(社内/協力会社)
	# 中身が"空"の場合の注意表示
	if (!@_){
		$cont = "\t\t<tr>\n" ;
		$cont .= "\t\t\t<td colspan=\"4\">実装対象の部品が発令されていません。（除外品）</td>\n" ;
		$cont .= "\t\t</tr>\n" ;
	}else{
		foreach my $dbData(@_){
			if (!defined @$dbData[4]){@$dbData[4] = "" ;}		# bossBOM基数
			if (!defined @$dbData[5]){@$dbData[5] = "" ;}		# egpro基数
			if (defined @$dbData[6]){$regDate = @$dbData[6] ;}	# egpro登録日時
#			if (!$mentori{@$dbData[3]}){$mentori{@$dbData[3]} = 1 ;}
#			@$dbData[5] = @$dbData[5] / $mentori{@$dbData[3]} ;
			my $partNo =@$dbData[3] ;
			if ( @$dbData[5] eq "" || (@$dbData[4] - @$dbData[5]) > 0 ){
				@$dbData[3] = "<font color = \"ff4040\"><b>".@$dbData[3]."</b></font>" ;	# 品目コード
				@$dbData[4] = "<b>".@$dbData[4]."</b>" ;	# BOSS基数
				@$dbData[5] = "<font color = \"ff4040\"><b>".@$dbData[5]."</b></font>" ;	# EGpro基数
			}elsif ( @$dbData[4] eq "" || (@$dbData[4] - @$dbData[5]) < 0 ){
				@$dbData[3] = "<font color = \"4040ff\"><b>".@$dbData[3]."</b></font>" ;	# 品目コード
				@$dbData[4] = "<b>".@$dbData[4]."</b>" ;	# BOSS基数
				@$dbData[5] = "<font color = \"4040ff\"><b>".@$dbData[5]."</b></font>" ;	# EGpro基数
			}
			if ($ret1 % 2){
				$cont .= "\t\t<tr class=\"even\">\n" ;
			}else{
				$cont .= "\t\t<tr class=\"odd\">\n" ;
			}
			# 除外登録のチェックボックス
			$cont .= "\t\t\t<td>".@$dbData[3]."</td><td>".@$dbData[4]."</td><td>".@$dbData[5]."</td>" ;
			$cont .= "<td><input type=\"checkbox\" name=\"".$partNo."\" value=\"partNo\"></td>\n" ;
			$cont .= "\t\t</tr>\n" ;
			$ret1 = $ret1 + 1 ;
		}
	$cont .= <<"HTML";
		<tr>
			<td colspan="2" class="button" style="text-align: left;">
				<input type="button" value="csv出力" onClick="dlFile('sashizu')" id="dnload" style="background-color:#d0ffff;"/>
			</td>
			<td colspan="2" class="button" style="text-align: right;">
				<input type="submit" name="exempt" value="除外登録" style="background-color:#d0ffff;"/>
			</td>
		</tr>
HTML
	}
end_sub:
	return $cont ;
}

# ---- egproBOM(SMT基数DB)の更新 ----
# 入力された品目のBOSS品目・基数と生産場所を元にegproテーブルを更新する。
# 引数：(部品コード)のcsv
# 戻り値：正常時:登録件数
#		エラー時:"err"、$ret1:エラー詳細
sub upd_egproBOM(){
	$ret1 = 0 ;	
	my ($db, $st, $ary_ref, $sql) ;
	eval{
		$db = DBI->connect($db_source, $db_user, $db_passwd, {PrintError => 0, AutoCommit => 0}) or die($DBI::errstr) ;
		# 指図(品目)のBOMをbomDiff DB から取得
		$sql = "SELECT `typeID`,`subType`,`unitQty` FROM `".$db_bomDiff."` WHERE `orderNumber` LIKE '".$in{'sashizu'}."' ;" ;
#print "(393)".$sql."<br>\n" ;
		$st = $db->prepare($sql) or die(DBI::errstr) ;
		$st->execute() or die(DBI::errstr) ;
		$ary_ref = $st->fetchall_arrayref ;
		$st->finish ;
		# 既存egproBOM DBの当該品目を削除
		$sql = "DELETE FROM `".$db_egproBOM."` WHERE `typeID` LIKE '".@$ary_ref[0]->[0]."' ;" ;
#print "(400)".$sql."<br>\n" ;
		$st = $db->prepare($sql) or die(DBI::errstr) ;
		$st->execute() or die(DBI::errstr) ;
		$st = $db->commit ;
		# 指図(品目)のBOMと生産場所をegproBOMに書込む
		$sql = "INSERT INTO ".$db_egproBOM." (typeID,partNo_egpro,qty,plant,regDate) VALUES " ;
		if ($in{'plantName'} eq "社内"){ $in{'plantName'} = "0" ; }
		foreach (@$ary_ref){
			# bomDiffのbossBOM側基数が"0"のものは書き込まない
			if (@$_[2] == 0){ next ; }
			$sql .= "('".@$_[0]."','".@$_[1]."',".@$_[2].",'".$in{'plantName'}."','".&dateTime(time)."')," ;
			$ret1 = $ret1 + 1 ;
		}
		$sql =~ s/,$// ;
#print "(414)".$sql."<br>\n" ;
		$st = $db->prepare($sql) or die(DBI::errstr) ;
		$st->execute() or die(DBI::errstr) ;
		$st = $db->commit ;
		$db->disconnect ;
	};
	#DBでエラーがある場合の処理
	if ($@){
		$st = $db->rollback ;
		if(defined($db)){$db->disconnect() ;}
		$ret1 = "egproBOM DB error : <br>sql : ".$sql."<br> ==> ".$@ ;
		return "err" ;
	}
	return $ret1 ;
}

# ---- ECN連携の確認 ----
# ECN DBから、全ECN情報を取得する。
# 引数：なし
# 戻り値：正常時:取得情報のリファレンス
#		エラー時:"err"、$ret1:エラー詳細
sub ecnLink(){
	my ($db, $st, $sql, $ary_ref) ;
	eval{
		$db = DBI->connect($db3_source, $db_user, $db_passwd, {PrintError => 0, AutoCommit => 0}) or die($DBI::errstr) ;
		$sql = "SELECT `ECNid`,`docNo`,`typeID`,`path`,`comm` FROM `".$db3_ecn."` WHERE 1 ;" ;
		$st = $db->prepare($sql) or die(DBI::errstr) ;
		$st->execute() or die(DBI::errstr) ;
		$ary_ref = $st->fetchall_arrayref ;
		$st->finish() ;
		$db->disconnect ;
	};
	#DBでエラーがある場合の処理
	if ($@){
		$st = $db->rollback ;
		if(defined($db)){$db->disconnect() ;}
		$ret1 = "exempt DB error : <br>sql : ".$sql."<br> ==> ".$@ ;
		return "err" ;
	}
	return $ary_ref ;
}

# ---- 除外リスト登録 ----
# 指定された部品コードを除外リストDBに登録する。
# 追番を除いて同一コードに上書き。
# 引数：(部品コード)のcsv
# 戻り値：正常時:登録件数
#		エラー時:"err"、$ret1:エラー詳細
sub reg_exempt(){
	$ret1 = 0 ;	
	my ($db, $st, $sql) ;
	eval{
		$db = DBI->connect($db_source, $db_user, $db_passwd, {PrintError => 0, AutoCommit => 0}) or die($DBI::errstr) ;
		# 全追番も含めて削除
		foreach (split (",", $_[0])){
			if ($_ =~ /^(\d{6}|\d{10})[A-Za-z]?$/) {	# 部品コード:数字6または10ケタ+英字0-1ケタ
				$sql = "DELETE FROM `".$db_exempt."` WHERE `partNo` LIKE '".$1."%' ;" ;
				$st = $db->prepare($sql) or die(DBI::errstr) ;
				$st->execute() or die(DBI::errstr) ;
			}
		}
		$st = $db->commit ;
		# 最新追番のみ追加
		$sql = "INSERT INTO `".$db_exempt."` (`partNo`) VALUES (?) " ;
		$st = $db->prepare($sql) or die(DBI::errstr) ;
		foreach (split (",", $_[0])){
			$st->execute($_) or die(DBI::errstr) ;
		}
		$st = $db->commit ;
		$db->disconnect ;
	};
	#DBでエラーがある場合の処理
	if ($@){
		$st = $db->rollback ;
		if(defined($db)){$db->disconnect() ;}
		$ret1 = "exempt DB error : <br>sql : ".$sql."<br> ==> ".$@ ;
		return "err" ;
	}
	return $ret1 ;
}

# ---- bossBOM DBから削除 ----
# 指定された部品コードをbossBOM DBから削除する。
# 引数：(部品コード)のcsv
# 戻り値：正常時:削除件数
#		エラー時:"err"、$ret1:エラー詳細
sub remv_bossBOM(){
	$ret1 = 0 ;	
	my ($db, $st, $sql) ;
	eval{
		$db = DBI->connect($db_source, $db_user, $db_passwd, {PrintError => 0, AutoCommit => 0}) or die($DBI::errstr) ;
		# 構成品目コード(部品コード)でbossDBから削除
		$sql = "DELETE FROM `".$db_bossBOM."` WHERE `partNo` LIKE ? ;" ;
		$st = $db->prepare($sql) or die(DBI::errstr) ;
		foreach (split (",", $_[0])){
			$st->execute($_) or die(DBI::errstr) ;
		}
		$st = $db->commit ;
		# 構成品目コード(部品コード)でegproDBから削除
		$sql = "DELETE FROM `".$db_egproBOM."` WHERE `partNo_egpro` LIKE ? ;" ;
		$st = $db->prepare($sql) or die(DBI::errstr) ;
		foreach (split (",", $_[0])){
			$st->execute($_) or die(DBI::errstr) ;
		}
		$st = $db->commit ;
		$db->disconnect ;
	};
	#DBでエラーがある場合の処理
	if ($@){
		$st = $db->rollback ;
		if(defined($db)){$db->disconnect() ;}
		$ret1 = "bomDiff DB error : <br>sql : ".$sql."<br> ==> ".$@ ;
		return "err" ;
	}
	return $ret1 ;
}

# ---- Logの出力 ----
# 引数で渡されるメッセージのlogファイル出力。
# バッファリングを解除、書込み禁止して排他処理して更新。
# 引数：メッセージテキスト
# 戻り値：エラーなしはNULL、ありはメッセージを返す。
sub recLog(){
	if (open (FH, ">>", $logFile)){
		print FH @_;
		close FH;
	}else{
		$ret1 = "Log File Error:".$!;
		close FH;
		return "err";
	}
	close FH;
	return 0;
}

# ---- 入力引数の評価 ----
# %in{''}で渡された入力引数を評価。
# 引数：なし(グローバル変数で%in
# 戻り値：なし(グローバル変数で%in)
sub eval_arg(){
	# モードの設定(部品コードの取得とモード設定)
	foreach (keys %in){
		if ($_ eq "sts"){			# 値:"sts" → 一覧画面から
			$in{'mode'} = "init" ;
		}
		if ($in{$_} eq "partNo"){	# 値:"partNo" → 除外部品コード(複数を配列化)
			$in{'mode'} = "exempt" ;
			push (@{$in{'partNo'}}, $_)
		}
		if ($_ eq "exempt"){		# 値:"exempt" → 除外部品登録
			$in{'mode'} = "exempt" ;
		}
		if ($_ eq "chgplant"){		# 値:"chgplant" → 生産場所変更
			$in{'mode'} = "chgplant" ;
		}
	}
}

# ---- エラー表示処理 ----
# エラーメッセージを表示
# 引数:エラーテキスト
# 戻り値:なし
sub error(){
		print "Content-type:text/html\n\n";
		print "<html>\n<body><meta charset=\"utf-8\" />\n";
		print "\t<br>".$_[0]."<br>\n";
		print "</body>\n</html>\n";
}

# ---- 画面の生成 ----
# 差分を表示する。
# 引数：なし
# 戻り値：なし
sub drw_scrn(){
	my $html = <<"HTML";
<!DOCTYPE html>
<html lang="jp">
<head>
	<title>SMT実装部品 差分表示プログラム</title>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<link rel="shortcut icon" href="/img/bom_diff/favicon.ico" type="image/vnd.microsoft.icon" />
	<link rel="icon" href="/img/bom_diff/favicon.ico" type="image/vnd.microsoft.icon" />
	<script type="text/javascript" src="./jquery/fixed_midashi.js"></script>
	<script type="text/javascript" src="./bom_diff.js"></script>
	<style>
		/* テーブルの書式・色 	*/
		table {
			border:solid 1px #ffcdcd; border-collapse: collapse;
			margin:10px 0px 15px 0px;
		}
		th {
			border:solid 1px #ffcdcd; border-collapse: collapse;
			background-color:#e6eeee; 
			font-size: 1.0em;
			text-align: center;
		}
		th.sel {
			background-color:#d0d8d8; 
		}
		tr.odd {
			border:solid 1px #ffcdcd; border-collapse: collapse;
			background-color:#ffe4e4;
			text-align:center; 
		}
		tr.even {
			border:solid 1px #ffcdcd; border-collapse: collapse;
			background-color:#e4e4ff;
			text-align:center; 
		}
		td {text-align: center; border:solid 1px #ffcdcd; border-collapse: collapse;}
		td.left {text-align: left;}
		td.right {text-align: right;}
		td.button {padding:5px; border-left:hidden; border-bottom:hidden; border-right:hidden;}
		/* FixMidashiの設定 */
		div.scroll_div {overflow: auto;}
	</style>
</head>
<body style="font-family: sans-serif; margin: 30px;" onLoad="FixedMidashi.create();">
<h2>【差分チェックシステム】（指図毎詳細）</h2>
<hr width="560" size="5" color="d0d0ff" align="left">
HTML
	# 指図関連情報の表示
	$html .= "<form name=\"form1\" method=\"get\" action=\"".$self_scrn."\">\n" ;
	$html .= "指図：<b><span id=\"sashizu\">".$sashizu."</span></b>\n" ;
	$html .= "　担当：<b><span id=\"line\">".$line."</span></b>\n" ;
	$html .= "　品目：<b><span id=\"typeID\">".$typeID."</span></b>\n" ;
	$html .= "　発令台数：<b><span id=\"qty\">".$qty."</span></b><br>\n" ;
	$html .= "製造開始日：<b><span id=\"sttDate\">".$sttDate."</span></b>\n" ;
	$html .= "　完成予定日：<b><span id=\"finDate\">".$finDate."</span><br></b>\n" ;
	if (!defined $plant){
		$html .= "生産場所：<b><span>未登録</span></b>\n" ;
	}elsif ($plant eq "0"){
		$html .= "生産場所：<b><span>社内</span></b>\n" ;
	}else{
		$html .= "生産場所：<b><span>".decode('utf8',$plant)."</span></b>\n" ;
	}
	$html .= "　<input type=\"button\" onClick=\"chgPlant()\" id=\"chgBtn\" value=\"変更\" style=\"background-color:#ffd0d0;\"><br>\n" ;
	$html .= "<hr width=\"560\" size=\"1\" color=\"d0d0ff\" align=\"left\">\n" ;
	# 差分表示選択
	$html .= "　差分：" ;
	if ($in{'sts'} eq "egp" || $in{'sts'} eq "bos"){	# 不一致：赤
		$html .= "<img src=\"./cgiData/red.png\">" ;
	}elsif ($in{'sts'} eq "upd"){					# 登録今日：青
		$html .= "<img src=\"./cgiData/blu.png\">" ;
	}elsif ($in{'sts'} eq "0"){						# 一致：緑
		$html .= "<img src=\"./cgiData/grn.png\">" ;
	}elsif ($in{'sts'} eq "-999"){					# 未登録：白
		$html .= "<img src=\"./cgiData/wht.png\">" ;
	}else{											# これ以外
		$html .= "N.A.(sts=".$in{'sts'}.")" ;
	}
	$html .= "（登録日時：" ;
	if (defined $regDate){
		$html .= "<b>".$regDate."</b>）\n" ;
	}else{
		$html .= "N.A.）\n" ;
	}
	# 不一致のときECN連携表示
	if ( $in{'sts'} =~ /bos|egp/ ){ 
		my $ecn = &ecnLink() ;
		if ($ecn eq "err"){
			$ret1 = "ECN連携に失敗しました。<br>".$ret1."<br>\n" ;
		}else{
			$typeID =~ /([A-Z\-]{3,4}\d{4})/ ;						# "UR-nnnn"を抽出
			my $keytypeID = $1 ;
			my $ecn_html = "" ;
			foreach (@$ecn){
				if ( @$_[2] =~ /($keytypeID[0-9\-X]{0,4})/ ){		# 対象品目群の該当UR-nnnnm-xyも含め抽出
					# 該当品目抽出
					$ecn_html .= "<br>　".@$_[0]." / ".$1." / ".@$_[1] ;
					if (!@$_[4]){
						$ecn_html .= "\n" ;
					}else{
						$ecn_html .= " (".decode('utf8',@$_[4]).")\n" ;
					}
				}
			}
			if (!$ecn_html){
				$html .= "<br>　ECN未発行\n" ;
			}else{
				$html .= $ecn_html ;
			}
		}
	}
	
	# 詳細の表示
	$html .= "<div class=\"scroll_div\">\n" ;
	$html .= "\t<table border=\"0\" id=\"sashizu_t\" style=\"margin-left: 0px; padding: 5px; background-color: #ffffff;\" class=\"fixedHead\" _fixedhead=\"rows:1; cols:0;\">\n" ;	
	$html .= "\t\t<thead>" ;
	$html .= "\t\t\t<tr>\n" ;
	$html .= "\t\t\t<th style=\"width: 150px;\">部品コード</th>\n" ;
	$html .= "\t\t\t<th style=\"width: 120px;\">BOSS基数</th>\n" ;
	$html .= "\t\t\t<th style=\"width: 120px;\">SMT基数</th>\n" ;
	$html .= "\t\t\t<th style=\"width: 100px;\">除外登録</th>\n" ;
	$html .= "\t\t\t</tr>\n" ;
	$html .= "\t\t</thead>\n" ;
	$html .= "\t\t<tbody>\n" ;
	$html .= $_[0] ;
	$html .= "\t\t</tbody>\n" ;
	$html .= "\t</table>\n" ;
	$html .= "\t\t<input type=\"hidden\" name=\"sashizu\" value=\"".$sashizu."\">\n";
	$html .= "\t\t<input type=\"hidden\" name=\"typeID\" value=\"".$typeID."\">\n";
#	$html .= "\t\t<input type=\"hidden\" name=\"chgplant\" value=\"\">\n";
	# $html .= "\t\t<input type=\"hidden\" name=\"wkrID\" value=\"".$in{'wkrID'}."\">\n";
	# $html .= "\t\t<input type=\"hidden\" name=\"line\" value=\"".$in{'line'}."\">\n";
	$html .= "</div>" ;
	$html .= "</form>" ;
	$html .= "</body>" ;
	$html .= "</html>" ;
	print $html;
}

# ---- 時刻生成処理 ----
# unix時刻を規定形式で戻す
# 引数:unix時刻
# 戻り値:YYYY-MM-DD HH:MM:SS 形式の日時
sub dateTime(){
	my @t = localtime($_[0]);
	return sprintf("%04d-%02d-%02d %02d:%02d:%02d",$t[5]+1900,$t[4]+1,$t[3],$t[2],$t[1],$t[0]);
}

# ---- 時刻をunix時刻に変換 ----
# 時刻をunix時刻に変換して戻す
# 引数:YYYY-MM-DD HH:MM:SS形式、またはYYYY/MM/DD HH:MM:SS形式の時刻
# 戻り値:unix時刻
sub unixTime(){
	my $t = $_[0] ;
	$t =~ s/\//-/g ;
	$t =~ /(\d{4}).(\d{2}).(\d{2}) (\d{2}):(\d{2}):(\d{2})/ ;
	return timelocal($6,$5,$4,$3,$2-1,$1-1900) ;
}

exit_prog: