	$in{'plantName'} =~ s/\s|　//g ;
	if (!$in{'plantName'}){$in{'plantName'} = "0" ;}
	if (&upd_egproBOM() eq "err"){
		&recLog( "failed for changing plant of egproBOM DB.\n".$ret1."\n" ) ; 
		$ret1 = "SMT基数・生産場所の更新に失敗しました。<br>".$ret1 ;
		&error($ret1) ;
		goto exit_prog ;
	}
	# 親ウィンドウ/自画面を更新・閉じる
	my $html = <<"HTML";
Content-type:text/html

<html><body>
<script type="text/javascript">
	window.onload = function(){
		window.opener.location.reload();
		open('about:blank', '_self').close();	// 自ウィンドウを閉じる
	}
</script>
</body></html>
HTML
	print $html ;
	&recLog("success changing plnat : ".$in{'partNo'}." / ".$in{'plantName'}."\n") ; 
	goto exit_prog ;
}elsif(defined $in{'sashizu'}){
	# **** 通常画面表示 ****
	print "Content-type:text/html\n\n";
	&recLog("normal start ==> ") ; 
}else{
	# **** 不明パラメータ ****
	$ret1 = "不正なパラメータです。画面を閉じてください。<br>" ;
