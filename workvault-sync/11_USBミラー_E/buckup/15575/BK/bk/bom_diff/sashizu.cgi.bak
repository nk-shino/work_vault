# **** ログ開始 ****
if (&recLog(&dateTime(time)." *** Ver.".$ver." START *** " ) eq "err"){
	$ret1 = "<font color=\"ff0000\">ローカルファイル(log)が開けません。<br>処理を終了します。:".$ret1."</font><br>\n";
