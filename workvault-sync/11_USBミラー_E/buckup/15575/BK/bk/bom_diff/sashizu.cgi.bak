# **** 設定ファイルを読む ****
if (!open(IN, "<", "./bom_diff.ini")){
	$ret1 = "'bom_diff.ini' is not be able to open ".$!."\n" ;
	$ret1 .= "System set the initial value. " ;
	&recLog($ret1) ;
}else{
	while (<IN>){
		my $val = $_ ;
		$val =~ s/\r\n|\r|\n//g ;
		if ($val =~ /#/){
			next ;
		}elsif ($val =~ /db_source.+\s(.+)$/){
			$val = $1 ;
			$db_source =~ s/(.+:)(.+)$/$1$val/ ;
		}elsif ($val =~ /db3_source.+\s(.+)$/){
			$val = $1 ;
			$db3_source	=~ s/(.+:)(.+)$/$1$val/ ;
		}
	}
	$ret1 = "=> system reads 'bom_diff.ini' " ;
	&recLog($ret1) ;
}
close IN ;
