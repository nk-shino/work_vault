        },
        {
          "text": "\u63a1\u7528\u3068\u4e0d\u63a1\u7528: \u5404\u30b7\u30b9\u30c6\u30e0\u306b\u3064\u3044\u3066\u3001\u63a1\u7528\u3059\u308b\u6307\u91dd\u3068\u63a1\u7528\u3057\u306a\u3044\u6307\u91dd(\u307e\u305f\u306f\u898b\u9001\u308a)\u306e\u4e21\u65b9\u304c\u66f8\u304b\u308c\u3066\u3044\u308b",
          "passed": true,
