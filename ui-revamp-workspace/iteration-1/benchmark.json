          "evidence": "\u00a73 \u304c3\u30b7\u30b9\u30c6\u30e0\u5225\u306e\u63a1\u7528\u6307\u91dd\u3002\u00a74\u300c\u73fe\u72b6\u306e\u307e\u307e\u7dad\u6301\u3059\u308b\u3082\u306e\u300d\u304c\u5404\u30b7\u30b9\u30c6\u30e0\u306e\u6307\u91dd\u306b\u7167\u3089\u3057\u305f\u4e0d\u5909\u66f4\u5224\u65ad\uff08Atlassian Typography/Empty state/Section message\u3001Carbon expressive\u3001GOV.UK Details/Warning text \u306b\u7167\u3089\u3057\u65e2\u5b58\u304c\u9069\u5408\uff09\u3001\u00a76 \u898b\u9001\u308a\u306b GOV.UK Typography \u306e\u53c2\u7167\u898b\u9001\u308a\u30fbMDN \u6a21\u5023\u898b\u9001\u308a\u30fb\u300c\u63a1\u7528\u5019\u88dc 3 \u30b7\u30b9\u30c6\u30e0\u306e\u6307\u91dd\u306b\u6839\u62e0\u304c\u306a\u3044\u300d\u9805\u76ee\uff08\u30a2\u30f3\u30ab\u30fc\u30ea\u30f3\u30af\u7b49\uff09\u3092\u660e\u8a18\u3002"
        },
        {
          "text": "\u512a\u5148\u5ea6\u4ed8\u304d\u5019\u88dc\u8868: \u5019\u88dc\u30fb\u9069\u7528\u5148\u30fb\u5099\u8003\u3092\u542b\u3080\u5019\u88dc\u8868\u304c P1/P2/P3 \u306e\u512a\u5148\u5ea6\u4ed8\u304d\u3067\u5b58\u5728\u3059\u308b",
          "passed": true,
          "evidence": "\u00a75 \u306e\u8868\u306f \u5019\u88dc/\u9069\u7528\u5148/\u51fa\u5178/\u512a\u5148\u5ea6 \u3067 A1\u301cA4=P1\u3001A5=P2\u3001A6=P3\u3002\u5099\u8003\u306f\u8868\u306e\u5217\u3067\u306f\u306a\u304f\u76f4\u5f8c\u306e\u300c\u5099\u8003\uff08\u5b9f\u88c5\u4e0a\u306e\u5236\u7d04\uff09\u300d\u7bc0\uff08\u30c6\u30b9\u30c8\u6587\u8a00\u306e\u7dad\u6301\u30fbA1 \u306e\u79fb\u52d5\u3068\u8aad\u307f\u4e0a\u3052\u9806\u30fbA4 \u306e HTML \u9806\u5e8f\u4e0d\u5909\uff09\u3068\u3057\u3066\u5019\u88dc\u8868\u306b\u4ed8\u968f\u3057\u3066\u304a\u308a\u3001\u5185\u5bb9\u306f\u63c3\u3063\u3066\u3044\u308b\u3002"
        },
        {
          "text": "\u898b\u9001\u308a\u3068\u7406\u7531: \u5b9f\u88c5\u3057\u306a\u3044\u9805\u76ee\u3068\u305d\u306e\u7406\u7531\u304c\u660e\u8a18\u3055\u308c\u3066\u3044\u308b",
          "passed": true,
          "evidence": "\u00a76\u300c\u898b\u9001\u308a\u3068\u305d\u306e\u7406\u7531\u300d\u306e\u8868\u306b9\u4ef6\uff08MDN \u6a21\u5023\u3001GOV.UK Typography \u53c2\u7167\u3001\u672c\u6587\u30ab\u30e9\u30e0\u8aad\u307f\u5e45\u3001\u30b5\u30a4\u30c9\u30ca\u30d3\u7b49\u30ec\u30a4\u30a2\u30a6\u30c8\u79fb\u690d\u3001\u898b\u51fa\u3057\u30a2\u30f3\u30ab\u30fc\u30ea\u30f3\u30af\u3001fieldset/legend \u5909\u66f4\u3001hero grid \u7f6e\u63db\u3001\u95a2\u9023\u8a9e\u8868\u5f62\u5f0f\u5316\u3001\u7d75\u6587\u5b57\uff09\u3067\u3001\u5404\u9805\u76ee\u306b\u7406\u7531\uff08\u6839\u62e0\u3092\u793a\u305b\u306a\u3044\u30fb\u90e8\u5206\u63a1\u7528\u306e\u5931\u6557\u30d1\u30bf\u30fc\u30f3\u30fb\u73fe\u884c\u3067\u540c\u7b49\u6a5f\u80fd\u7b49\uff09\u3002"
        },
        {
          "text": "\u5224\u65ad\u304c\u5fc5\u8981\u306a\u70b9: \u5b9f\u88c5\u524d\u306b\u30e6\u30fc\u30b6\u30fc\u306e\u6c7a\u5b9a\u304c\u5fc5\u8981\u306a\u8a2d\u8a08\u5206\u5c90\u304c\u660e\u793a\u3055\u308c\u3066\u3044\u308b",
          "passed": true,
          "evidence": "\u00a77\u300c\u5224\u65ad\u304c\u5fc5\u8981\u306a\u70b9\u300d\u306b3\u4ef6\u3092\u300c\u5b9f\u88c5\u524d\u306b\u6c7a\u5b9a\u304c\u5fc5\u8981\u306a\u8a2d\u8a08\u4e0a\u306e\u5206\u5c90\u300d\u3068\u3057\u3066\u660e\u793a\uff08\u8a55\u4fa1\u30d5\u30a9\u30fc\u30e0\u6298\u308a\u305f\u305f\u307f\u306e\u8981\u5426\u3068 A6 \u306e\u4f9d\u5b58\u95a2\u4fc2\u3001\u8a9e\u7fa9\u30e1\u30bf\u884c\u306e\u4e26\u3073\u9806\u3001\u96a0\u3057\u63a5\u982d\u8a9e\u306e\u6587\u8a00\u78ba\u5b9a\uff09\u3002\u5404\u9805\u76ee\u306b\u5206\u5c90\u306e\u5e30\u7d50\uff08\u7573\u3080\u5834\u5408/\u7573\u307e\u306a\u3044\u5834\u5408\u306e\u5bfe\u5fdc\uff09\u307e\u3067\u66f8\u304b\u308c\u3066\u3044\u308b\u3002"
        },
        {
          "text": "\u90e8\u5206\u63a1\u7528: \u53c2\u7167\u5148UI\u306e\u5168\u9762\u79fb\u690d(MDN\u306e\u30da\u30fc\u30b8\u69cb\u6210\u306e\u4e38\u3054\u3068\u5c0e\u5165\u7b49)\u3092\u63d0\u6848\u305b\u305a\u3001\u6307\u91dd\u5358\u4f4d\u306e\u90e8\u5206\u63a1\u7528\u306b\u7559\u307e\u3063\u3066\u3044\u308b",
          "passed": true,
          "evidence": "\u00a76 \u3067\u300cMDN \u81ea\u4f53\u306e\u6a21\u5023\uff08\u30ec\u30a4\u30a2\u30a6\u30c8\u30fb\u90e8\u54c1\u306e\u79fb\u690d\uff09\u300d\u3068\u300c\u30b5\u30a4\u30c9\u30ca\u30d3\u30fb\u76ee\u6b21\u30fb\u30bf\u30d6\u7b49\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u79fb\u690d\uff08\u90e8\u5206\u63a1\u7528\u306e\u5931\u6557\u30d1\u30bf\u30fc\u30f3\u306b\u8a72\u5f53\uff09\u300d\u3092\u898b\u9001\u308a\u3002\u00a72 \u3067\u306f MDN \u306e\u96f0\u56f2\u6c17\u3092\u300c\u9577\u6587\u306e\u5b9a\u7fa9\u3092\u8aad\u307f\u3084\u3059\u304f\u793a\u3059/\u30e1\u30bf\u60c5\u5831\u306e\u5206\u96e2/\u6ce8\u610f\u306f\u672c\u6587\u3067\u4f1d\u3048\u308b\u300d\u306b\u5206\u89e3\u3057\u6307\u91dd\u3067\u88cf\u53d6\u308a\u3059\u308b\u65b9\u6cd5\u3092\u660e\u793a\u3002\u5019\u88dc A1\u301cA6 \u306f\u898b\u51fa\u3057\u306e\u60c5\u5831\u5206\u96e2\u30fbh2 \u8abf\u6574\u30fb\u96a0\u3057\u63a5\u982d\u8a9e\u30fb\u4f59\u767d\u30fb\u6298\u308a\u305f\u305f\u307f\u7b49\u306e\u6307\u91dd\u5358\u4f4d\u3002"
        },
        {
          "text": "\u5b9f\u5728\u3059\u308b\u51fa\u5178: \u6319\u3052\u3089\u308c\u305fURL\u306f\u5b9f\u5728\u3057\u3001\u305d\u306e\u30da\u30fc\u30b8\u5185\u5bb9\u3068\u8a18\u8f09\u304c\u4e00\u81f4\u3059\u308b(\u634f\u9020\u3055\u308c\u305f\u51fa\u5178\u304c\u306a\u3044)",
          "passed": true,
          "evidence": "6URL \u3068\u3082 webfetch \u3067\u53d6\u5f97\u3057\u5185\u5bb9\u7167\u5408\u6e08\u307f\u3002Atlassian Typography\uff08\u300c\u898b\u51fa\u3057\u306f\u65b0\u3057\u3044\u5185\u5bb9\u306e\u533a\u5207\u308a\u3092\u5c0e\u5165\u3059\u308b\u305f\u3081\u306b\u4f7f\u3046\u300d\u300cheading styles, rather than bold or a change of font size\u300d\u300ch1 \u306f1\u30da\u30fc\u30b81\u3064\u30fb\u30ec\u30d9\u30eb\u3092\u98db\u3070\u3055\u306a\u3044\u300d\u300cBody L \u306f\u9577\u6587\u306e\u65e2\u5b9a\u300d\u300c\u8996\u899a\u968e\u5c64\u3068\u4f59\u767d\u3067\u8907\u96d1\u306a\u60c5\u5831\u3092\u6574\u7406\u300d\uff09\u3001Empty state usage\uff08\u898b\u51fa\u3057/\u8aac\u660e/\u30dc\u30bf\u30f3\u306e\u69cb\u6210\u30fbCTA \u306e\u7d5e\u308a\u8fbc\u307f\uff09\u3001Section message usage\uff08\u8272\u3060\u3051\u306b\u983c\u3089\u306a\u3044\u30fb\u884c\u304d\u6b62\u307e\u308a\u3092\u907f\u3051\u5bfe\u5fdc\u624b\u6bb5\u3092\u793a\u3059\uff09\u3001Carbon Typography overview\uff08expressive/productive \u306e\u4f7f\u3044\u5206\u3051\u30fb\u300cSemiBold \u2026 ideal for section headers, but should not be used for long text\u300d\u30fb\u672c\u6587\u8272\u306f\u30cb\u30e5\u30fc\u30c8\u30e9\u30eb\u3067\u4e3b\u8981\u8272\u306f\u4e3b\u64cd\u4f5c\u3068\u30ea\u30f3\u30af\uff09\u3001GOV.UK Details\uff08\u300c\u4e00\u90e8\u306e\u5229\u7528\u8005\u306b\u3060\u3051\u5fc5\u8981\u306a\u60c5\u5831\u300d\u300c\u5927\u534a\u306e\u5229\u7528\u8005\u306b\u5fc5\u8981\u306a\u60c5\u5831\u306f\u7573\u307e\u306a\u3044\u300d\u300c\u30bf\u30d6\u3084\u30a2\u30b3\u30fc\u30c7\u30a3\u30aa\u30f3\u3088\u308a\u76ee\u7acb\u305f\u306a\u3044\u300d\uff09\u3001Warning text\uff08aria-hidden \u306e\u300e!\u300f\u30a2\u30a4\u30b3\u30f3+\u592a\u5b57+govuk-visually-hidden \u306e 'Warning'\uff09\u3002\u4e00\u81f4\u3057\u306a\u3044\u8a18\u8f09\u306f\u898b\u3064\u304b\u3089\u305a\u3002"
        },
        {
          "text": "\u73fe\u72b6\u8e0f\u307e\u3048: \u5bfe\u8c61\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u306e\u65e2\u5b58\u8981\u7d20(\u8a9e\u7fa9\u30fb\u51fa\u81ea\u30fb\u95a2\u9023\u8a9e\u30fb\u5c65\u6b74\u7b49)\u306b\u89e6\u308c\u305f\u63d0\u6848\u306b\u306a\u3063\u3066\u3044\u308b",
          "passed": true,
          "evidence": "\u00a71 \u306b term_detail.html \u306e\u69cb\u6210\uff08\u30d1\u30f3\u304f\u305a\u30fbhero \u306e\u8aad\u307f/\u82f1\u8a9e/\u7565\u8a9e/\u7248\u3068\u5c65\u6b74\u30ea\u30f3\u30af\u30fb\u6df7\u540c\u6ce8\u610f\u30fb\u8a9e\u7fa9\u30ab\u30fc\u30c9\u306e h3 \u306b6\u7a2e\u4f75\u8a18\u3068\u8a55\u4fa1\u30d5\u30a9\u30fc\u30e0\u30fb\u95a2\u9023\u8a9e\u30fbdetails 2\u4ef6\uff09\u3068\u8ab2\u984c3\u70b9\u3001\u30c6\u30b9\u30c8\u691c\u67fb\u6587\u5b57\u5217\u306e\u4fdd\u8b77\u5bfe\u8c61\u8868\u3002A1\u301cA6 \u306e\u9069\u7528\u5148\u304c\u8a9e\u7fa9 h3\u30fbh2\u30fb\u6df7\u540c\u6ce8\u610f\u30bb\u30af\u30b7\u30e7\u30f3\u30fb.evaluate\u30fb\u30e1\u30bf\u884c\u306b\u7d10\u3065\u304f\u3002"
        }
