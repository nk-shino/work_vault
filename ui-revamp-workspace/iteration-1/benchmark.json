        },
        {
          "text": "\u512a\u5148\u5ea6\u4ed8\u304d\u5019\u88dc\u8868: \u5019\u88dc\u30fb\u9069\u7528\u5148\u30fb\u5099\u8003\u3092\u542b\u3080\u5019\u88dc\u8868\u304c P1/P2/P3 \u306e\u512a\u5148\u5ea6\u4ed8\u304d\u3067\u5b58\u5728\u3059\u308b",
          "passed": false,
          "evidence": "P1/P2/P3 \u306e\u8868\u8a18\u306f\u6587\u66f8\u5168\u4f53\u306b\u5b58\u5728\u3057\u306a\u3044\u3002\u00a74.1 \u5224\u65ad\u4e00\u89a7\u306f \u5bfe\u8c61\u8981\u7d20/\u5224\u65ad/\u501f\u308a\u308b\u6307\u91dd/\u4e3b\u306a\u51fa\u5178 \u306e\u8868\u3067\u512a\u5148\u5ea6\u306e\u6982\u5ff5\u304c\u306a\u304f\u3001\u00a76 \u306e\u300c\u7740\u624b\u9806\u306e\u76ee\u5b89\u300d\uff08\u5f71\u97ff\u306e\u5927\u304d\u3044\u9806\u306e5\u6bb5\u968e\uff09\u3082\u512a\u5148\u5ea6\u30e9\u30d9\u30eb\u3067\u306f\u306a\u3044\u3002"
        },
        {
          "text": "\u898b\u9001\u308a\u3068\u7406\u7531: \u5b9f\u88c5\u3057\u306a\u3044\u9805\u76ee\u3068\u305d\u306e\u7406\u7531\u304c\u660e\u8a18\u3055\u308c\u3066\u3044\u308b",
          "passed": true,
          "evidence": "\u00a74.1 \u306b\u898b\u9001\u308a\u884c\uff08\u30b5\u30a4\u30c9\u30d0\u30fc\u5316\u30fb\u8868\u5f62\u5f0f\u3078\u306e\u5168\u9762\u5909\u66f4\u30fbJS \u88fd\u30b3\u30f3\u30dd\u30fc\u30cd\u30f3\u30c8\u5c0e\u5165\u30fb\u7121\u9650\u30b9\u30af\u30ed\u30fc\u30eb\uff09\u3001D11 \u898b\u9001\u308a\u30ea\u30b9\u30c8\u306b7\u4ef6\u306e\u8868\uff08\u898b\u9001\u308a\u9805\u76ee/\u7406\u7531\uff09\u3002\u5404\u7406\u7531\u306f\u5217\u6b63\u898f\u5316\u306e\u4e0d\u53ef\u80fd\u6027\u30fbURL \u72b6\u614b\u4fdd\u6301\u3068\u306e\u77db\u76fe\u30fb\u76e3\u67fb\u8981\u4ef6\u306a\u3069\u5177\u4f53\u7684\u3002"
        },
        {
          "text": "\u5224\u65ad\u304c\u5fc5\u8981\u306a\u70b9: \u5b9f\u88c5\u524d\u306b\u30e6\u30fc\u30b6\u30fc\u306e\u6c7a\u5b9a\u304c\u5fc5\u8981\u306a\u8a2d\u8a08\u5206\u5c90\u304c\u660e\u793a\u3055\u308c\u3066\u3044\u308b",
          "passed": false,
          "evidence": "\u5b9f\u88c5\u524d\u306e\u30e6\u30fc\u30b6\u30fc\u6c7a\u5b9a\u3092\u8981\u3059\u308b\u8a2d\u8a08\u5206\u5c90\u306e\u660e\u793a\u7684\u306a\u4e00\u89a7\u304c\u306a\u3044\u3002\u00a76\u300c\u5b9f\u88c5\u3092\u59cb\u3081\u308b\u3068\u304d\u306e\u7559\u610f\u70b9\u300d\u306e6\u70b9\u306f\u8aad\u307f\u4e0a\u3052\u9806\u306e\u78ba\u8a8d\u30fbnoscript \u5bfe\u5fdc\u30fb\u30ec\u30b9\u30dd\u30f3\u30b7\u30d6\u30fbCSS \u6574\u5408\u3068\u3044\u3063\u305f\u5b9f\u88c5\u6642\u30c1\u30a7\u30c3\u30af\u3067\u3001\u300c\u5b9f\u88c5\u524d\u306b\u30e6\u30fc\u30b6\u30fc\u304c\u6c7a\u3081\u308b\u3079\u304d\u5206\u5c90\u300d\u3068\u3057\u3066\u63d0\u793a\u3057\u3066\u3044\u306a\u3044\u3002D1\u300c\u5b9f\u88c5\u306e\u53ef\u5426\u542b\u3081\u3001\u5b9f\u88c5\u6642\u306b app.js \u3068\u4e00\u4f53\u3067\u691c\u8a0e\u3059\u308b\u300d\u7b49\u306f\u6c7a\u5b9a\u3092\u5148\u9001\u308a\u306b\u3059\u308b\u8a18\u8ff0\u306b\u3068\u3069\u307e\u308b\u3002"
        },
        {
          "text": "\u90e8\u5206\u63a1\u7528: \u53c2\u7167\u5148UI\u306e\u5168\u9762\u79fb\u690d(\u30b5\u30a4\u30c9\u30d0\u30fc\u3084\u30b3\u30de\u30f3\u30c9\u30d1\u30ec\u30c3\u30c8\u7b49\u306e\u69cb\u6210\u306e\u4e38\u3054\u3068\u5c0e\u5165)\u3092\u63d0\u6848\u305b\u305a\u3001\u6307\u91dd\u5358\u4f4d\u306e\u90e8\u5206\u63a1\u7528\u306b\u7559\u307e\u3063\u3066\u3044\u308b",
          "passed": true,
          "evidence": "\u00a70 \u3067\u300c\u6307\u91dd\u306e\u300e\u8003\u3048\u65b9\u3068\u69cb\u9020\u300f\u3092\u90e8\u5206\u63a1\u7528\u3059\u308b\u300d\u3068\u660e\u8a00\u3002\u00a71.3 \u306f GitHub \u4e00\u89a7\u306e\u69cb\u6210\u3092\u6574\u7406\u3057\u305f\u4e0a\u3067\u300c\u3053\u306e\u69cb\u6210\u3092\u305d\u306e\u307e\u307e\u771f\u4f3c\u308b\u306e\u3067\u306f\u306a\u304f\u2026\u53d6\u6368\u3059\u308b\u300d\u3068\u660e\u793a\u3057\u3001D11 \u3067\u8868\u5f62\u5f0f\u3078\u306e\u5168\u9762\u5909\u66f4\u30fbJS \u88fd\u30b3\u30f3\u30dd\u30fc\u30cd\u30f3\u30c8\u5c0e\u5165\u30fb\u30b5\u30a4\u30c9\u30d0\u30fc\u5316\u30fb\u72b6\u614b\u30bf\u30d6\u3092\u898b\u9001\u308a\u3002\u63d0\u6848\u306f\u884c\u306e3\u9818\u57df\u5316\u30fb\u30d0\u30c3\u30b8\u5206\u96e2\u7b49\u306e\u6307\u91dd\u5358\u4f4d\u3067\u30b5\u30fc\u30d0\u30fc\u30ec\u30f3\u30c0\u30ea\u30f3\u30b0\u69cb\u6210\u306b\u53ce\u307e\u3063\u3066\u3044\u308b\u3002"
        },
        {
          "text": "\u5b9f\u5728\u3059\u308b\u51fa\u5178: \u6319\u3052\u3089\u308c\u305fURL\u306f\u5b9f\u5728\u3057\u3001\u305d\u306e\u30da\u30fc\u30b8\u5185\u5bb9\u3068\u8a18\u8f09\u304c\u4e00\u81f4\u3059\u308b(\u634f\u9020\u3055\u308c\u305f\u51fa\u5178\u304c\u306a\u3044)",
          "passed": true,
          "evidence": "\u5f15\u7528\u306e\u8981\u8ae6\u3092\u53d6\u5f97\u3067\u7167\u5408: Filter\uff08dropdown/Filter/SelectPanel \u306e\u4f7f\u3044\u5206\u3051\u30fb\u300c\u9078\u629e\u304c\u660e\u78ba\u306a dropdown \u306b\u306f\u5373\u6642\u9069\u7528\u300d\u30fbURL \u4fdd\u6301\u30fbrevert\u30fb\u9069\u7528\u4e2d\u30d5\u30a3\u30eb\u30bf\u306e\u8868\u793a\u30fb\u30bc\u30ed\u4ef6\u6642\u306e\u7a7a\u72b6\u614b\u30fbrole=\"status\" \u3067\u306e\u901a\u77e5\u30fb\u5b9f\u4f8b 'Filter the list of issues in a repository'\uff09\u3001Task list\uff08\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u30dc\u30bf\u30f3\u3068\u8aa4\u89e3\u3055\u308c\u305f\u6539\u826f\u7d4c\u7def\u30fb\u5927\u6587\u5b57\u56de\u907f\u30fbCompleted \u306f\u80cc\u666f\u8272\u306a\u3057\u9ed2\u6587\u5b57\u30fbhint \u306f\u77ed\u65871\u3064\u53e5\u70b9\u306a\u3057\u30fbhint \u5185\u30ea\u30f3\u30af\u7981\u6b62\u30fbaria-describedby\uff09\u3001Pagination\uff08'Previous and next links only' \u304c\u516c\u5f0f\u5f62\u614b\u30fb\u756a\u53f7\u4ed8\u304d\u306f\u5148\u982d\u672b\u5c3e\u4fdd\u6301+\u7701\u7565\u8a18\u53f7\uff09\u3001ProgressBar\uff08\u5024\u30c6\u30ad\u30b9\u30c8\u4f75\u8a18\u304c\u65e2\u5b9a\u30fb\u7701\u7565\u306f\u610f\u56f3\u7684\u306b\u66d6\u6627\u306b\u3059\u308b\u5834\u5408\u306e\u307f\uff09\u3001Empty states\uff08\u4e3b/\u526f\u30c6\u30ad\u30b9\u30c8\u30fb\u4e3b/\u526f\u64cd\u4f5c\u30fbcode \u30d6\u30ed\u30c3\u30af\u5909\u5f62\u30fb\u67a0\u7dda\uff09\u3001StateLabel\uff08'used for rendering the status of an issue or pull request'\uff09\u3002Atlassian \u7a7a\u72b6\u614b\u6307\u91dd\u3082 'Include the reason for the empty state and where they can go next / Avoid repeating content from the title / one to two sentences' \u3067\u4e00\u81f4\u3002\u672a\u76f4\u63a5\u53d6\u5f97\u5206\uff08Primer Label \u7b49\uff09\u306f\u516c\u5f0f\u30c9\u30e1\u30a4\u30f3\u3068\u5185\u5bb9\u6574\u5408\u3067\u5224\u5b9a\u3002\u634f\u9020\u306f\u898b\u3064\u304b\u3089\u306a\u304b\u3063\u305f\u3002"
        },
        {
          "text": "\u73fe\u72b6\u8e0f\u307e\u3048: \u5bfe\u8c61\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u306e\u65e2\u5b58\u8981\u7d20(\u63d0\u6848\u30ab\u30fc\u30c9\u30fb\u72b6\u614b\u30fb\u78ba\u304b\u3089\u3057\u3055\u8868\u793a\u7b49)\u306b\u89e6\u308c\u305f\u63d0\u6848\u306b\u306a\u3063\u3066\u3044\u308b",
