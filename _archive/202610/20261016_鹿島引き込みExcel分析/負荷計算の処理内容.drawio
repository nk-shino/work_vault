t="1"><mxGeometry x="876" y="222" width="240" height="44" as="geometry"/></mxCell><mxCell id="L2_G2_t" value="90 / 300 / 390" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#243447;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="272" width="110" height="44" as="geometry"/></mxCell><mxCell id="L2_G2_d" value="スロット上限。3ノズルヘッド用90・&lt;br&gt;その他300・合計390" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="876" y="272" width="240" height="44" as="geometry"/></mxCell><mxCell id="L2_G3_t" value="非共有スロット" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#243447;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="322" width="110" height="44" as="geometry"/></mxCell><mxCell id="L2_G3_d" value="選択品目群が他ジョブと共有しない&lt;br&gt;部品のスロット数(専用分)" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="876" y="322" width="240" height="44" as="geometry"/></mxCell><mxCell id="L2_G4_t" value="0.8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#243447;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="372" width="110" height="44" as="geometry"/></mxCell><mxCell id="L2_G4_d" value="テーブル禁止判定だけに使う安全率。&lt;br&gt;150〜270に乗算した値と比較" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="876" y="372" width="240" height="44" as="geometry"/></mxCell><mxCell id="L2_O" value="結果の使われ方&lt;br&gt;BOSS取込時は計算シートの「フリー容量」列へ書込。&lt;br&gt;空きが負(オーバー)なら載せ替えが必要。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#243447;fontSize=10;" vertex="1" parent="1"><mxGeometry x="56" y="572" width="290" height="56" as="geometry"/></mxCell><mxCell id="L2_SRC" value="出所: TOOL.xlam BuhinKakunin_ADO(tool_vba.txt:3759-3944・表示:3939-3942) / BOSS計画.xlsm Cal_Capa(vba_code_all.txt:573-663) / テーブル禁止判定 x=0.8(tool_vba.txt:3921-3927) / 部品リスト.accdb 実データ(egproBOM 178,952行・PartList 11,546行)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontColor=#666666;fontSize=10;align=left;spacing=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="692" width="1074" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="LOAD-03" name="3_処理2_時間負荷計算"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="8" page="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="L3_T" value="処理2 時間負荷計算 — その日の中に収まるか" style="text;html=1;fontSize=22;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1090" height="34" as="geometry"/></mxCell><mxCell id="L3_ST" value="BOSS計画.xlsm chkTime / getBOSS_btn。サイクルタイムは実績平均(DGS最速値ではない)。" style="text;html=1;fontSize=12;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1090" height="22" as="geometry"/></mxCell><mxCell id="L3_R" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F4FAF4;strokeColor=#82B366;strokeWidth=2;dashed=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1090" height="600" as="geometry"/></mxCell><mxCell id="L3_R_h" value="処理2 時間負荷計算" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#82B366;strokeColor=#82B366;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1090" height="40" as="geometry"/></mxCell><mxCell id="L3_FH" value="計算ロジック(メイン)" style="text;html=1;fontSize=13;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="56" y="146" width="560" height="22" as="geometry"/></mxCell><mxCell id="L3_F1" value="工数(h) = ( ①数量 × ②CT + ③600秒 ) ÷ ④3600 ÷ ⑤0.7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontColor=#243447;fontSize=14;fontFamily=Courier New;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56" y="172" width="560" height="56" as="geometry"/></mxCell><mxCell id="L3_F2" value="⑤の方向に注意: ÷0.7 は工数を約1.43倍に膨らませる。&lt;br&gt;×0.7(縮める)の実装はコード内に存在しない。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#243447;fontSize=11;fontFamily=Courier New;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56" y="240" width="560" height="60" as="geometry"/></mxCell><mxCell id="L3_CH" value="②CT(サイクルタイム)の決め方" style="text;html=1;fontSize=13;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="56" y="312" width="560" height="22" as="geometry"/></mxCell><mxCell id="L3_C1" value="MySQL QCD.CycleTime_Points&lt;br&gt;から品目×表裏ごとに&lt;br&gt;最新10指図を取得" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#243447;fontSize=10;" vertex="1" parent="1"><mxGeometry x="56" y="338" width="260" height="60" as="geometry"/></mxCell><mxCell id="L3_C2" value="CT&lt;28 →&lt;br&gt;28に補正" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#243447;fontSize=10;" vertex="1" parent="1"><mxGeometry x="356" y="338" width="120" height="60" as="geometry"/></mxCell><mxCell id="L3_C3" value="表裏それぞれ&lt;br&gt;平均" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#243447;fontSize=10;" vertex="1" parent="1"><mxGeometry x="496" y="338" width="120" height="60" as="geometry"/></mxCell><mxCell id="L3_C4" value="表+裏を合計=品目のCT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#243447;fontSize=10;" vertex="1" parent="1"><mxGeometry x="356" y="410" width="260" height="44" as="geometry"/></mxCell><mxCell id="L3_E1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=1.5;fontSize=10;fontColor=#243447;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L3_C1" target="L3_C2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L3_E2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=1.5;fontSize=10;fontColor=#243447;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L3_C2" target="L3_C3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L3_E3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=1.5;fontSize=10;fontColor=#243447;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L3_C3" target="L3_C4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L3_AH" value="CTがDBに無い品目の代替ロジック" style="text;html=1;fontSize=13;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="56" y="468" width="560" height="22" as="geometry"/></mxCell><mxCell id="L3_F3" value="組取り数あり: 数量 ÷ 組取り数 × 56(量産)/75(試作) + 600&lt;br&gt;組取り数なし: 数量 × 56(量産)/75(試作) + 600&lt;br&gt;どちらも無い: 数量 × 28 + 600 → ★印でリストに残す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontColor=#243447;fontSize=11;fontFamily=Courier New;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56" y="494" width="560" height="96" as="geometry"/></mxCell><mxCell id="L3_SH" value="手順(集約まで)" style="text;html=1;fontSize=13;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="656" y="146" width="460" height="22" as="geometry"/></mxCell><mxCell id="L3_S0" value="⑥ 品目ごとに工数を算出(上記ロジック)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontColor=#243447;fontSize=10;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="656" y="172" width="460" height="54" as="geometry"/></mxCell><mxCell id="L3_S1" value="⑦ 計算シートに日付×グループで書込&lt;br&gt;(フリー/L1-L3試作/TEC-5600/TEC-1000/送信機/AED)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontColor=#243447;fontSize=10;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="656" y="234" width="460" height="54" as="geometry"/></mxCell><mxCell id="L3_S2" value="⑧ グループごとの停止時間と合算し&lt;br&gt;日次の枠と照合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontColor=#243447;fontSize=10;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="656" y="296" width="460" height="54" as="geometry"/></mxCell><mxCell id="L3_S3" value="※ 同じ数式が getBOSS_btn にも重複実装&lt;br&gt;(ソース内に「超注意」の注記あり)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontColor=#243447;fontSize=10;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="656" y="358" width="460" height="54" as="geometry"/></mxCell><mxCell id="L3_GH" value="計算ロジック内の言葉の説明" style="text;html=1;fontSize=13;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="656" y="424" width="460" height="22" as="geometry"/></mxCell><mxCell id="L3_G0_t" value="① 数量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontColor=#243447;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="656" y="450" width="96" height="44" as="geometry"/></mxCell><mxCell id="L3_G0_d" value="指図の生産台数(MySQL scheduled&lt;br&gt;liveOrder.orderQty)" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="758" y="450" width="358" height="44" as="geometry"/></mxCell><mxCell id="L3_G1_t" value="② CT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontColor=#243447;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="656" y="484" width="96" height="44" as="geometry"/></mxCell><mxCell id="L3_G1_d" value="1台当たりの実績生産秒数。&lt;br&gt;最新10指図の平均。DGS最速値ではない" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="758" y="484" width="358" height="44" as="geometry"/></mxCell><mxCell id="L3_G2_t" value="③ 600秒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontColor=#243447;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="656" y="518" width="96" height="44" as="geometry"/></mxCell><mxCell id="L3_G2_d" value="1指図あたりの段取時間(10分)。&lt;br&gt;指図ごとに必ず加算" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="758" y="518" width="358" height="44" as="geometry"/></mxCell><mxCell id="L3_G3_t" value="④ 3600" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontColor=#243447;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="656" y="552" width="96" height="44" as="geometry"/></mxCell><mxCell id="L3_G3_d" value="秒 → 時間への換算" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="758" y="552" width="358" height="44" as="geometry"/></mxCell><mxCell id="L3_G4_t" value="⑤ 0.7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontColor=#243447;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="656" y="586" width="96" height="44" as="geometry"/></mxCell><mxCell id="L3_G4_d" value="安全率。÷して約1.43倍に膨らませ、&lt;br&gt;計画に余裕を持たせる方向" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="758" y="586" width="358" height="44" as="geometry"/></mxCell><mxCell id="L3_G5_t" value="組取り数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontColor=#243447;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="656" y="620" width="96" height="44" as="geometry"/></mxCell><mxCell id="L3_G5_d" value="1回の部品組取りで生産できる台数。&lt;br&gt;MySQL scheduled.unitInfo.chldID" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="758" y="620" width="358" height="44" as="geometry"/></mxCell><mxCell id="L3_G6_t" value="28秒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontColor=#243447;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="656" y="654" width="96" height="44" as="geometry"/></mxCell><mxCell id="L3_G6_d" value="CTの下限。短すぎる実績値の補正。&lt;br&gt;処理3のBOMシートと共通の規則" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="758" y="654" width="358" height="44" as="geometry"/></mxCell><mxCell id="L3_SRC" value="出所: BOSS計画.xlsm chkTime(vba_code_all.txt:486-567・代替値56/75は502-504・★は544) / getBOSS_btn(:835-861) / パワークエリ(pq_extract/Formulas_Section1.m:4-7 ROW_NUMBER&lt;=10・28補正)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontColor=#666666;fontSize=10;align=left;spacing=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="636" width="1074" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="LOAD-04" name="4_処理3_Asprova割付け"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="8" page="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="L4_T" value="処理3 Asprova割付け — 容量を超えない仕組み" style="text;html=1;fontSize=22;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1090" height="34" as="geometry"/></mxCell><mxCell id="L4_ST" value="「超えない」は事前の合否判定ではなく、カレンダー内へ割付ける調整の結果。" style="text;html=1;fontSize=12;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1090" height="22" as="geometry"/></mxCell><mxCell id="L4_R" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F9F4FA;strokeColor=#9673A6;strokeWidth=2;dashed=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1090" height="600" as="geometry"/></mxCell><mxCell id="L4_R_h" value="処理3 Asprova割付け" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#9673A6;strokeColor=#9673A6;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1090" height="40" as="geometry"/></mxCell><mxCell id="L4_FH" value="計算ロジック" style="text;html=1;fontSize=13;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="56" y="146" width="560" height="22" as="geometry"/></mxCell><mxCell id="L4_F1" value="作業時間 = ①数量 × ②sp ÷ ③製造効率 + ④段取" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontColor=#243447;fontSize=14;fontFamily=Courier New;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56" y="172" width="560" height="56" as="geometry"/></mxCell><mxCell id="L4_F2" value="②sp = CT ÷ 面数(表裏)&lt;br&gt;   BOM作成シートN列 =($E$15/$F$15)&amp;&quot;sp&quot; (単位 sp=秒/個)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontColor=#243447;fontSize=11;fontFamily=Courier New;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56" y="240" width="560" height="60" as="geometry"/></mxCell><mxCell id="L4_F3" value="③製造効率 = UseBomInst_ProductionFactor&lt;br&gt;   実装0.7 / 目視0.6 / 外観検査0.5 / 二課1.0&lt;br&gt;   0.7なら実時間の約1.43倍を計上" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontColor=#243447;fontSize=11;fontFamily=Courier New;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56" y="312" width="560" height="76" as="geometry"/></mxCell><mxCell id="L4_F4" value="④段取にも効率適用: 10m÷0.7=14.28571m&lt;br&gt;   実績の段取計画も「10M」と「14M17S」の2種のみ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontColor=#243447;fontSize=11;fontFamily=Courier New;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56" y="400" width="560" height="60" as="geometry"/></mxCell><mxCell id="L4_WH" value="割付けの流れ" style="text;html=1;fontSize=13;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="56" y="476" width="560" height="22" as="geometry"/></mxCell><mxCell id="L4_W1" value="製造BOM&lt;br&gt;(テーブル要素)&lt;br&gt;BOMシートから手作業で追加" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontColor=#243447;fontSize=10;" vertex="1" parent="1"><mxGeometry x="56" y="502" width="170" height="60" as="geometry"/></mxCell><mxCell id="L4_W2" value="オーダー(指図)&lt;br&gt;数量・期日" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#243447;fontSize=10;" vertex="1" parent="1"><mxGeometry x="254" y="502" width="170" height="60" as="geometry"/></mxCell><mxCell id="L4_W3" value="作業時間を計算&lt;br&gt;(上記ロジック)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontColor=#243447;fontSize=10;" vertex="1" parent="1"><mxGeometry x="452" y="502" width="164" height="60" as="geometry"/></mxCell><mxCell id="L4_W4" value="資源カレンダーの&lt;br&gt;空きへ割付け" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontColor=#243447;fontSize=10;" vertex="1" parent="1"><mxGeometry x="452" y="574" width="164" height="56" as="geometry"/></mxCell><mxCell id="L4_W5" value="入らない場合&lt;br&gt;順延 / 代替資源へ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#243447;fontSize=10;" vertex="1" parent="1"><mxGeometry x="254" y="574" width="170" height="56" as="geometry"/></mxCell><mxCell id="L4_E1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;strokeWidth=1.5;fontSize=10;fontColor=#243447;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L4_W1" target="L4_W3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L4_E2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;strokeWidth=1.5;fontSize=10;fontColor=#243447;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L4_W2" target="L4_W3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L4_E3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;strokeWidth=1.5;fontSize=10;fontColor=#243447;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L4_W3" target="L4_W4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L4_E4" value="収まらないとき" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;strokeWidth=1.5;fontSize=10;fontColor=#243447;labelBackgroundColor=#FFFFFF;;dashed=1" edge="1" parent="1" source="L4_W4" target="L4_W5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L4_N1" value="実データの裏付け: 作業テーブル実績「(総時間−段取)÷数量」と BOMの sp÷0.7 の比較 → 49行中41行(84%)が一致。" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="56" y="636" width="560" height="40" as="geometry"/></mxCell><mxCell id="L4_GH" value="計算ロジック内の言葉の説明" style="text;html=1;fontSize=13;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="656" y="146" width="460" height="22" as="geometry"/></mxCell><mxCell id="L4_G0_t" value="① 数量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontColor=#243447;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="656" y="172" width="120" height="44" as="geometry"/></mxCell><mxCell id="L4_G0_d" value="指図の生産台数" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="782" y="172" width="334" height="44" as="geometry"/></mxCell><mxCell id="L4_G1_t" value="② sp(秒/個)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontColor=#243447;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="656" y="232" width="120" height="44" as="geometry"/></mxCell><mxCell id="L4_G1_d" value="1個当たりの製造時間=CT÷面数。&lt;br&gt;表裏2面ならCTを2で割る" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="782" y="232" width="334" height="44" as="geometry"/></mxCell><mxCell id="L4_G2_t" value="③ 製造効率" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontColor=#243447;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="656" y="292" width="120" height="44" as="geometry"/></mxCell><mxCell id="L4_G2_d" value="工程別に設定。&lt;br&gt;÷することで計画時間が膨らむ" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="782" y="292" width="334" height="44" as="geometry"/></mxCell><mxCell id="L4_G3_t" value="④ 段取" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontColor=#243447;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="656" y="352" width="120" height="44" as="geometry"/></mxCell><mxCell id="L4_G3_d" value="作業の前に加算する時間。&lt;br&gt;製造BOMでは 10m または 14.28571m" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="782" y="352" width="334" height="44" as="geometry"/></mxCell><mxCell id="L4_G4_t" value="製造BOM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontColor=#243447;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="656" y="412" width="120" height="44" as="geometry"/></mxCell><mxCell id="L4_G4_d" value="Asprovaのテーブル要素。&lt;br&gt;品目×工程ごとに行で保持" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="782" y="412" width="334" height="44" as="geometry"/></mxCell><mxCell id="L4_G5_t" value="資源カレンダー" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontColor=#243447;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="656" y="472" width="120" height="44" as="geometry"/></mxCell><mxCell id="L4_G5_d" value="装置ごとの稼働可能時間枠。&lt;br&gt;ここに入る範囲でしか作業を置かない" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="782" y="472" width="334" height="44" as="geometry"/></mxCell><mxCell id="L4_G6_t" value="順延・代替資源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontColor=#243447;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="656" y="532" width="120" height="44" as="geometry"/></mxCell><mxCell id="L4_G6_d" value="収まらない作業を後ろの日へずらす、&lt;br&gt;または別の資源に割り替える調整" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="782" y="532" width="334" height="44" as="geometry"/></mxCell><mxCell id="L4_SRC" value="出所: 差分確認マクロ BOM作成シート O1=UseBomInst_ProductionFactor・N1=($E$15/$F$15)&amp;&quot;sp&quot;・M1=&quot;10m&quot;・E13注記 / 実データ: 製造BOM 24,763行(効率分布・段取表記)、作業テーブル96行(実績照合 41/49一致)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontColor=#666666;fontSize=10;align=left;spacing=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="682" width="1074" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="LOAD-05" name="5_共通用語と未確認事項"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="8" page="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="L5_T" value="共通用語と未確認事項" style="text;html=1;fontSize=22;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1090" height="34" as="geometry"/></mxCell><mxCell id="L5_ST" value="3処理をまたいで使う言葉と、現時点で確認できていない点。" style="text;html=1;fontSize=12;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1090" height="22" as="geometry"/></mxCell><mxCell id="L5_R1" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FEFBF0;strokeColor=#D6B656;strokeWidth=2;dashed=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1090" height="330" as="geometry"/></mxCell><mxCell id="L5_R1_h" value="共通の規則" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D6B656;strokeColor=#D6B656;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1090" height="40" as="geometry"/></mxCell><mxCell id="L5_C0a" value="サイクルタイム 2系統" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontColor=#243447;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="134" width="180" height="86" as="geometry"/></mxCell><mxCell id="L5_C0b" value="実装技術課の管理: DGS最速値(設備最大性能)。&lt;br&gt;生産1課の実績: MySQL最新10指図の平均。&lt;br&gt;負荷計算に使うのは実績平均の方。両者の差が&lt;br&gt;BSM-1700マスター検証の要点。" style="text;html=1;fontSize=11;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="252" y="134" width="850" height="86" as="geometry"/></mxCell><mxCell id="L5_C1a" value="28秒下限" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontColor=#243447;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="230" width="180" height="86" as="geometry"/></mxCell><mxCell id="L5_C1b" value="DGS実績が短すぎる場合の共通クリップ値。&lt;br&gt;BOSS計画パワークエリ・BOM作成シートで同じ28秒。" style="text;html=1;fontSize=11;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="252" y="230" width="850" height="86" as="geometry"/></mxCell><mxCell id="L5_C2a" value="0.7 の方向" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontColor=#243447;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="326" width="180" height="86" as="geometry"/></mxCell><mxCell id="L5_C2b" value="コードは全て ÷0.7(工数を約1.43倍に膨らませる)。&lt;br&gt;会議メモは「DGS最大値×安全係数」と記録。×方向は&lt;br&gt;実装と一致しない。意図は関係者への確認が必要。" style="text;html=1;fontSize=11;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="252" y="326" width="850" height="86" as="geometry"/></mxCell><mxCell id="L5_R2" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FEFBF0;strokeColor=#B85450;strokeWidth=2;dashed=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="1090" height="210" as="geometry"/></mxCell><mxCell id="L5_R2_h" value="未確認事項(今回の解析範囲で確認できなかった点)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#B85450;strokeColor=#B85450;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="1090" height="40" as="geometry"/></mxCell><mxCell id="L5_U0a" value="×0.7 の設計意図" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#243447;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="486" width="200" height="52" as="geometry"/></mxCell><mxCell id="L5_U0b" value="÷0.7が「余裕を持たせる」狙いか、別の意図(稼働率補正等)か。佐藤さん・実装技術課への確認が必要。" style="text;html=1;fontSize=11;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="272" y="486" width="840" height="52" as="geometry"/></mxCell><mxCell id="L5_U1a" value="BOMシートへのCT転記経路" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#243447;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="548" width="200" height="52" as="geometry"/></mxCell><mxCell id="L5_U1b" value="差分確認マクロBOM作成シートのE列CTが、MySQL実績平均とどう連結しているか(手作業/リンク)未確認。" style="text;html=1;fontSize=11;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="272" y="548" width="840" height="52" as="geometry"/></mxCell><mxCell id="L5_U2a" value="段取り予定.xlsx の実体" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#243447;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="200" height="52" as="geometry"/></mxCell><mxCell id="L5_U2b" value="SharePoint上のため今回未確認。ジョブ作成シートの容量確認処理はTOOL.xlam側の実装から推定。" style="text;html=1;fontSize=11;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="272" y="610" width="840" height="52" as="geometry"/></mxCell><mxCell id="L5_N1" value="数値・行番号の出所は 20261016_鹿島引き込みExcel分析/説明_負荷計算の処理内容.md §5 参照。&lt;br&gt;元ファイル(各xlsm/xlam/accdb)は読み取り専用で解析し、変更はしていない。" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="668" width="1090" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="LOAD-06" name="6_Asprova3テーブル実例"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="8" page="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="L6_T" value="Asprova ジョブ作成時の3テーブル — 実データの例" style="text;html=1;fontSize=22;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1090" height="34" as="geometry"/></mxCell><mxCell id="L6_ST" value="ジョブ作成時データテーブル一覧(オーダテーブル作業テーブル・製造BOM).xlsx から。値は実データの代表例。" style="text;html=1;fontSize=12;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1090" height="22" as="geometry"/></mxCell><mxCell id="L6_R1" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FEFBF0;strokeColor=#D6B656;strokeWidth=2;dashed=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1090" height="150" as="geometry"/></mxCell><mxCell id="L6_R1_h" value="オーダーテーブル(指図) 90行 — 何を・いつまでに" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D6B656;strokeColor=#D6B656;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1090" height="40" as="geometry"/></mxCell><mxCell id="L6_O1" value="指図コード 000212249572-2010&lt;br&gt;品目 URS-43833 / 数量 144台&lt;br&gt;納期 17:00 / 着手・完了実績あり&lt;br&gt;状態: 着手済み53行 / 未着手37行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontColor=#243447;fontSize=11;fontFamily=Courier New;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56" y="138" width="500" height="88" as="geometry"/></mxCell><mxCell id="L6_O2" value="指図コードの末尾(-2010等)は工程順序番号。オーダー1件が&lt;br&gt;工程ごとに分割して登録される。&lt;br&gt;納期と完了実績の差から「納期超過」を判定できる(AO列)。&lt;br&gt;製造オーダ/登録オーダの2種の番号を持つ。" style="text;html=1;fontSize=11;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="580" y="140" width="530" height="88" as="geometry"/></mxCell><mxCell id="L6_R2" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F3F7FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="1090" height="200" as="geometry"/></mxCell><mxCell id="L6_R2_h" value="作業テーブル 96行 — どの装置で・いつ動いたか" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#6C8EBF;strokeColor=#6C8EBF;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="1090" height="40" as="geometry"/></mxCell><mxCell id="L6_W1" value="実装-1 / SMT-1L / Line-1&lt;br&gt;指図 212249572 / 品目 URS-43833-2010&lt;br&gt;開始 10-16 10:53 → 終了 11:26 / 数量 10台&lt;br&gt;段取(計画) 14M17S / 総時間(実績) 32M50S&lt;br&gt;制約: 資源固定 / 命令: 強制バックワード" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#243447;fontSize=11;fontFamily=Courier New;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56" y="308" width="500" height="138" as="geometry"/></mxCell><mxCell id="L6_W2" value="1工程=1行。実装-1(52行)と実装-2(44行)のみで、&lt;br&gt;検査工程は行として持たない(製造BOM側で管理)。&lt;br&gt;資源は SMT-1L/2L/3L の3ライン。&lt;br&gt;時間列の対応: 製造時間(実績)+段取(計画)=総時間&lt;br&gt;が 49行中44行で成立。" style="text;html=1;fontSize=11;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="580" y="308" width="530" height="140" as="geometry"/></mxCell><mxCell id="L6_R3" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F9F4FA;strokeColor=#9673A6;strokeWidth=2;dashed=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="1090" height="160" as="geometry"/></mxCell><mxCell id="L6_R3_h" value="製造BOM 24,763行 — 工程ごとの時間と効率の定義" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#9673A6;strokeColor=#9673A6;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="1090" height="40" as="geometry"/></mxCell><mxCell id="L6_B1" value="品目 URS-43833 / 工程順序 2010(実装-1)&lt;br&gt;資源 SMT-1L〜3L(代替資源が行として並ぶ)&lt;br&gt;段取 14.28571m (=10m÷0.7) / 1個当たり 16.5954sp&lt;br&gt;効率 0.7 / 指図種別 U×M(使用指図)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontColor=#243447;fontSize=11;fontFamily=Courier New;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56" y="528" width="500" height="98" as="geometry"/></mxCell><mxCell id="L6_B2" value="工程の内訳: 目視6,408行 / 実装-2 5,950 / 実装-1 5,077 /&lt;br&gt;外観検査-1 4,213 / 二課 2,841。効率の分布: 0.7×9,645(実装) /&lt;br&gt;0.6×5,468(目視) / 0.5×2,269(外観検査) / 1.0×2,255(二課)。&lt;br&gt;二課は「3d」のように日単位の滞留で持つ。" style="text;html=1;fontSize=11;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="580" y="528" width="530" height="100" as="geometry"/></mxCell><mxCell id="L6_R4" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F3F7FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1090" height="130" as="geometry"/></mxCell><mxCell id="L6_R4_h" value="部品リスト.accdb — スロット容量判定の参照先" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#6C8EBF;strokeColor=#6C8EBF;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1090" height="40" as="geometry"/></mxCell><mxCell id="L6_A1" value="egproBOM 178,952行: 品目2,280種 × 部品名&lt;br&gt;PartList 11,546行: フィーダーサイズ・ノズル&lt;br&gt;BOM入力 429行 / tmp_BOM・tmp_DeleteList 0行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#243447;fontSize=11;fontFamily=Courier New;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56" y="708" width="500" height="68" as="geometry"/></mxCell><mxCell id="L6_A2" value="VBAが egproBOM で品目→部品名、PartList で部品名→&lt;br&gt;フィーダーサイズに引き当てる(2段引きの起点)。&lt;br&gt;フィーダーサイズ分布: 0.5×4,778 / 1×3,889 / 0×1,466 /&lt;br&gt;2×1,096 / 3×315 / 4×2。三ノズルヘッド=1が1,757部品。" style="text;html=1;fontSize=11;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="580" y="708" width="530" height="70" as="geometry"/></mxCell><mxCell id="L6_SRC" value="出所: ジョブ作成時データテーブル一覧(オーダテーブル作業テーブル・製造BOM).xlsx 3シート、部品リスト.accdb。列名(EM_*等)はAsprovaの内部列名のため英語表記のまま。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontColor=#666666;fontSize=10;align=left;spacing=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1090" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>