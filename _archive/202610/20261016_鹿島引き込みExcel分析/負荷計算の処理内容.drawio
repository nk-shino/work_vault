<mxfile host="Electron" modified="2026-10-16T00:00:00.000Z" agent="analysis" version="24.0.0"><!-- 負荷計算の処理内容 / 2026-10-16 / 根拠: TOOL.xlam・BOSS計画.xlsm・差分確認マクロver2.3a.xlsm VBA復号 --><diagram id="LOAD-01" name="1_全体像と色分け"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="8" page="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="L1_T" value="負荷計算の処理内容 — 全体像" style="text;html=1;fontSize=22;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1090" height="34" as="geometry"/></mxCell><mxCell id="L1_ST" value="「ジョブ作成なら容量に収まる」は3系統の計算とAsprovaの割付け調整で成り立つ。色=処理の種別。数値は全てコード・ブックから確認済み。" style="text;html=1;fontSize=12;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1090" height="22" as="geometry"/></mxCell><mxCell id="L1_DGS" value="DGS データ作成ジェエティタ&lt;br&gt;実装条件作成(機種別CT・CPH)&lt;br&gt;赤セル=ラインのネック機種" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#243447;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="240" height="74" as="geometry"/></mxCell><mxCell id="L1_ACC" value="部品リスト.accdb(実データ確認済)&lt;br&gt;egproBOM 178,952行 × PartList 11,546行&lt;br&gt;(nksv523\Job作成)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#243447;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="240" height="74" as="geometry"/></mxCell><mxCell id="L1_MY" value="MySQL nksv1359&lt;br&gt;QCD.CycleTime_Points(CT実績)&lt;br&gt;scheduled(数量・組取り数)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#243447;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="240" height="74" as="geometry"/></mxCell><mxCell id="L1_BOM" value="差分確認マクロ BOM作成シート&lt;br&gt;E=CT秒(28下限) N=sp O=効率&lt;br&gt;→ Asprova製造BOMの元" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#243447;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="240" height="74" as="geometry"/></mxCell><mxCell id="L1_R1" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F3F7FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="350" y="110" width="330" height="110" as="geometry"/></mxCell><mxCell id="L1_R1_h" value="処理1 スロット容量判定" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#6C8EBF;strokeColor=#6C8EBF;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="110" width="330" height="40" as="geometry"/></mxCell><mxCell id="L1_F1" value="Σフィーダーサイズ ≤ 390&lt;br&gt;(90 + 300)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#243447;fontSize=12;fontFamily=Courier New;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="366" y="158" width="298" height="54" as="geometry"/></mxCell><mxCell id="L1_R2" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F4FAF4;strokeColor=#82B366;strokeWidth=2;dashed=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="350" y="250" width="330" height="110" as="geometry"/></mxCell><mxCell id="L1_R2_h" value="処理2 時間負荷計算" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#82B366;strokeColor=#82B366;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="250" width="330" height="40" as="geometry"/></mxCell><mxCell id="L1_F2" value="工数(h)=(数量×CT+600)&lt;br&gt;÷3600 ÷0.7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontColor=#243447;fontSize=12;fontFamily=Courier New;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="366" y="298" width="298" height="54" as="geometry"/></mxCell><mxCell id="L1_R3" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F9F4FA;strokeColor=#9673A6;strokeWidth=2;dashed=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="350" y="390" width="330" height="110" as="geometry"/></mxCell><mxCell id="L1_R3_h" value="処理3 Asprova割付け" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#9673A6;strokeColor=#9673A6;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="390" width="330" height="40" as="geometry"/></mxCell><mxCell id="L1_F3" value="作業時間=数量×sp÷製造効率&lt;br&gt;+段取10m → カレンダー内へ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontColor=#243447;fontSize=12;fontFamily=Courier New;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="366" y="438" width="298" height="54" as="geometry"/></mxCell><mxCell id="L1_CSV" value="DGS出力CSV&lt;br&gt;(サイクルタイム/部品/フィーダー/ノズル)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#243447;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="240" height="50" as="geometry"/></mxCell><mxCell id="L1_O1" value="空きスロット表示&lt;br&gt;【ALL】x/390・3Noz x/90・Other x/300&lt;br&gt;テーブル禁止推奨数 T(安全率0.8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#243447;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="120" width="320" height="74" as="geometry"/></mxCell><mxCell id="L1_O2" value="計算シート(日付×グループ工数)&lt;br&gt;+各グループ停止時間&lt;br&gt;→ 日次の枠と照合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#243447;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="250" width="320" height="74" as="geometry"/></mxCell><mxCell id="L1_O3" value="Asprova ガントチャート&lt;br&gt;資源カレンダー内に割付け&lt;br&gt;入らない→順延・代替資源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#243447;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="390" width="320" height="74" as="geometry"/></mxCell><mxCell id="L1_E0" value="CSV出力" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1.5;fontSize=10;fontColor=#243447;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L1_DGS" target="L1_CSV"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L1_E1" value="TOOL.xlamが&lt;br&gt;MySQLへ登録" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1.5;fontSize=10;fontColor=#243447;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L1_CSV" target="L1_MY"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L1_E2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=10;fontColor=#243447;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L1_ACC" target="L1_R1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L1_E3" value="最新10指図の&lt;br&gt;実績平均CT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=1.5;fontSize=10;fontColor=#243447;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L1_MY" target="L1_R2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L1_E4" value="sp・製造効率" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;strokeWidth=1.5;fontSize=10;fontColor=#243447;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L1_BOM" target="L1_R3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L1_E5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=10;fontColor=#243447;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L1_R1" target="L1_O1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L1_E6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=1.5;fontSize=10;fontColor=#243447;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L1_R2" target="L1_O2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L1_E7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;strokeWidth=1.5;fontSize=10;fontColor=#243447;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L1_R3" target="L1_O3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L1_N1" value="ポイント&lt;br&gt;処理1は物理判定(部品×フィーダーサイズ)。処理2は時間判定(実績CT)。処理3は割付け調整。「超えない」は判定後の自動調整の結果。" style="text;html=1;fontSize=11;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="780" y="480" width="320" height="66" as="geometry"/></mxCell><mxCell id="L1_TBL" value="Asprova受け渡しデータの実例&lt;br&gt;→ 6_Asprova3テーブル実例 ページ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#243447;fontSize=10;" vertex="1" parent="1"><mxGeometry x="780" y="576" width="320" height="56" as="geometry"/></mxCell><mxCell id="L1_E8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;strokeWidth=1.5;fontSize=10;fontColor=#243447;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L1_R3" target="L1_TBL"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L1_LG0" value="色分け凡例" style="text;html=1;fontSize=12;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="200" height="20" as="geometry"/></mxCell><mxCell id="L1_LG0a" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#243447;fontSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="664" width="24" height="16" as="geometry"/></mxCell><mxCell id="L1_LG0b" value="処理1 スロット容量判定" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="70" y="664" width="170" height="18" as="geometry"/></mxCell><mxCell id="L1_LG1a" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#243447;fontSize=8;" vertex="1" parent="1"><mxGeometry x="240" y="664" width="24" height="16" as="geometry"/></mxCell><mxCell id="L1_LG1b" value="処理2 時間負荷計算" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="270" y="664" width="170" height="18" as="geometry"/></mxCell><mxCell id="L1_LG2a" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#243447;fontSize=8;" vertex="1" parent="1"><mxGeometry x="440" y="664" width="24" height="16" as="geometry"/></mxCell><mxCell id="L1_LG2b" value="処理3 Asprova割付け" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="470" y="664" width="170" height="18" as="geometry"/></mxCell><mxCell id="L1_LG3a" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#243447;fontSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="694" width="24" height="16" as="geometry"/></mxCell><mxCell id="L1_LG3b" value="データ源" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="70" y="694" width="170" height="18" as="geometry"/></mxCell><mxCell id="L1_LG4a" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#243447;fontSize=8;" vertex="1" parent="1"><mxGeometry x="240" y="694" width="24" height="16" as="geometry"/></mxCell><mxCell id="L1_LG4b" value="出力・結果" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="270" y="694" width="170" height="18" as="geometry"/></mxCell><mxCell id="L1_LG5a" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#243447;fontSize=8;" vertex="1" parent="1"><mxGeometry x="440" y="694" width="24" height="16" as="geometry"/></mxCell><mxCell id="L1_LG5b" value="注意・未確認" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="470" y="694" width="170" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="LOAD-02" name="2_処理1_スロット容量判定"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="8" page="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="L2_T" value="処理1 スロット容量判定 — 部品がフィーダーに載るか" style="text;html=1;fontSize=22;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1090" height="34" as="geometry"/></mxCell><mxCell id="L2_ST" value="実行タイミング: ジョブ作成時(TOOL.xlam 部品確認ボタン)と BOSS取込時(BOSS計画.xlsm)。両方とも同一ロジック。" style="text;html=1;fontSize=12;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1090" height="22" as="geometry"/></mxCell><mxCell id="L2_R" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F3F7FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1090" height="600" as="geometry"/></mxCell><mxCell id="L2_R_h" value="処理1 スロット容量判定" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#6C8EBF;strokeColor=#6C8EBF;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1090" height="40" as="geometry"/></mxCell><mxCell id="L2_SH" value="手順" style="text;html=1;fontSize=13;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="56" y="146" width="280" height="22" as="geometry"/></mxCell><mxCell id="L2_S0" value="① 品目ごとに部品リスト.accdbから&lt;br&gt;部品名・ノズル・フィーダーサイズを取得&lt;br&gt;(egproBOM×PartList / 部品は重複なく1回)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#243447;fontSize=10;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="56" y="172" width="290" height="66" as="geometry"/></mxCell><mxCell id="L2_S1" value="② ノズル欄に1000超の番号がある部品を&lt;br&gt;3ノズルヘッド用として集計を分離" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#243447;fontSize=10;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="56" y="246" width="290" height="66" as="geometry"/></mxCell><mxCell id="L2_S2" value="③ フィーダーサイズを合計&lt;br&gt;= 必要スロット数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#243447;fontSize=10;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="56" y="320" width="290" height="66" as="geometry"/></mxCell><mxCell id="L2_S3" value="④ 上限と比較&lt;br&gt;3ノズルヘッド用 90 / その他 300 / 合計 390" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#243447;fontSize=10;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="56" y="394" width="290" height="66" as="geometry"/></mxCell><mxCell id="L2_S4" value="⑤ 空きスロットを表示&lt;br&gt;【ALL】x/390・3Noz x/90・Other x/300" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#243447;fontSize=10;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="56" y="468" width="290" height="66" as="geometry"/></mxCell><mxCell id="L2_FH" value="計算ロジック" style="text;html=1;fontSize=13;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="380" y="146" width="340" height="22" as="geometry"/></mxCell><mxCell id="L2_F1" value="必要スロット(3Nzl)&lt;br&gt;  = Σフィーダーサイズ(ノズル&gt;1000の部品)&lt;br&gt;必要スロット(Other)&lt;br&gt;  = Σフィーダーサイズ(上記以外)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#243447;fontSize=11;fontFamily=Courier New;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="172" width="340" height="74" as="geometry"/></mxCell><mxCell id="L2_F2" value="判定: 3Nzl ≤ 90&lt;br&gt;      Other ≤ 300&lt;br&gt;      合計 ≤ 390" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#243447;fontSize=11;fontFamily=Courier New;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="258" width="340" height="66" as="geometry"/></mxCell><mxCell id="L2_F3" value="テーブル禁止推奨数 T:&lt;br&gt;非共有スロット ≥ 150×0.8(=120) → T+1&lt;br&gt;   以下 180/210/240/270 で同様に+1&lt;br&gt;優先度: T8 &gt; T6 &gt; T4 &gt; T2 &gt; T10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#243447;fontSize=11;fontFamily=Courier New;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="336" width="340" height="96" as="geometry"/></mxCell><mxCell id="L2_FN" value="Tは「他ジョブと共有しない部品」が増えたとき、使うべきでないテーブル数の推奨。スロット本体の合否判定には0.8は関与しない。" style="text;html=1;fontSize=10;fontColor=#243447;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="380" y="444" width="340" height="60" as="geometry"/></mxCell><mxCell id="L2_DB" value="照会先DB&lt;br&gt;\\nksv523...\Job作成\部品リスト.accdb&lt;br&gt;egproBOM(品目→部品) × PartList(部品→サイズ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#243447;fontSize=10;" vertex="1" parent="1"><mxGeometry x="380" y="518" width="340" height="60" as="geometry"/></mxCell><mxCell id="L2_E9" value="照会" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=10;fontColor=#243447;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L2_DB" target="L2_F1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L2_DH" value="部品リスト.accdb の中身(実データ)" style="text;html=1;fontSize=13;fontColor=#243447;align=left;vert